//@version=5
indicator("SPY GEX Levels – Futures Signal", overlay=true, max_lines_count=500, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// SPY GEX Key Levels Indicator  (Update these daily from your GEX app)
// ─────────────────────────────────────────────────────────────────────────────

// ── INPUTS: Update Daily ─────────────────────────────────────────────────────
grp1 = "GEX Key Levels (Update Daily)"
spotPrice    = input.float(735.75, "Spot Price",         group=grp1)
zeroGamma    = input.float(745.60, "Zero Gamma Level",   group=grp1, tooltip="Price where dealer gamma flips. Above = bullish dealer hedging. Below = bearish.")
callWall     = input.float(800.00, "Call Wall",          group=grp1, tooltip="Major resistance - dealers sell calls here, suppresses upside")
putWall      = input.float(720.00, "Put Wall",           group=grp1, tooltip="Major support - dealers buy puts here, accelerates downside if breached")
highStrike   = input.float(742.00, "Key Call Strike",    group=grp1, tooltip="Largest positive gamma strike from heatmap (e.g. $742)")
highPutStr   = input.float(740.00, "Key Put Strike",     group=grp1, tooltip="Largest negative gamma strike from heatmap (e.g. $740 0DTE)")

grp2 = "GEX Regime"
netGEXneg    = input.bool(true,    "Net GEX is NEGATIVE (bearish regime)", group=grp2, tooltip="When Net GEX < 0, market is in negative gamma - trends harder, more volatile")
zeroAboveSpot= input.bool(true,    "Zero Gamma ABOVE Spot (bearish pressure)", group=grp2)

grp3 = "Signal Settings"
showLevels   = input.bool(true,    "Show GEX Level Lines",   group=grp3)
showSignals  = input.bool(true,    "Show Buy/Sell Signals",  group=grp3)
showLabels   = input.bool(true,    "Show Level Labels",      group=grp3)
confirmBars  = input.int(2,        "Bars to Confirm Break",  group=grp3, minval=1, maxval=5)
useVolume    = input.bool(true,    "Require Above-Avg Volume for Signal", group=grp3)

grp4 = "Visuals"
colCallWall  = input.color(color.new(#00e676, 80), "Call Wall Color",    group=grp4)
colPutWall   = input.color(color.new(#ff1744, 80), "Put Wall Color",     group=grp4)
colZeroGamma = input.color(color.new(#ffeb3b, 70), "Zero Gamma Color",   group=grp4)
colCallStr   = input.color(color.new(#69f0ae, 60), "Call Strike Color",  group=grp4)
colPutStr    = input.color(color.new(#ff6d00, 60), "Put Strike Color",   group=grp4)

// ── LEVEL LINES (persistent, only created once) ──────────────────────────────
var line lineCallWall  = na
var line linePutWall   = na
var line lineZeroGamma = na
var line lineCallStr   = na
var line linePutStr    = na

if showLevels and barstate.islast
    if na(lineCallWall)
        lineCallWall  := line.new(bar_index - 200, callWall,  bar_index + 50, callWall,  color=colCallWall,  width=2, style=line.style_dashed)
        linePutWall   := line.new(bar_index - 200, putWall,   bar_index + 50, putWall,   color=colPutWall,   width=2, style=line.style_dashed)
        lineZeroGamma := line.new(bar_index - 200, zeroGamma, bar_index + 50, zeroGamma, color=colZeroGamma, width=2, style=line.style_dotted)
        lineCallStr   := line.new(bar_index - 200, highStrike,bar_index + 50, highStrike,color=colCallStr,   width=1, style=line.style_dotted)
        linePutStr    := line.new(bar_index - 200, highPutStr,bar_index + 50, highPutStr,color=colPutStr,    width=1, style=line.style_dotted)
    else
        line.set_x1(lineCallWall,  bar_index - 200)
        line.set_x2(lineCallWall,  bar_index + 50)
        line.set_y1(lineCallWall,  callWall)
        line.set_y2(lineCallWall,  callWall)
        line.set_x1(linePutWall,   bar_index - 200)
        line.set_x2(linePutWall,   bar_index + 50)
        line.set_y1(linePutWall,   putWall)
        line.set_y2(linePutWall,   putWall)
        line.set_x1(lineZeroGamma, bar_index - 200)
        line.set_x2(lineZeroGamma, bar_index + 50)
        line.set_y1(lineZeroGamma, zeroGamma)
        line.set_y2(lineZeroGamma, zeroGamma)
        line.set_x1(lineCallStr,   bar_index - 200)
        line.set_x2(lineCallStr,   bar_index + 50)
        line.set_y1(lineCallStr,   highStrike)
        line.set_y2(lineCallStr,   highStrike)
        line.set_x1(linePutStr,    bar_index - 200)
        line.set_x2(linePutStr,    bar_index + 50)
        line.set_y1(linePutStr,    highPutStr)
        line.set_y2(linePutStr,    highPutStr)

// ── LEVEL LABELS (persistent, only created once) ─────────────────────────────
var label lblCallWall  = na
var label lblPutWall   = na
var label lblZeroGamma = na
var label lblCallStr   = na
var label lblPutStr    = na

if showLabels and barstate.islast
    if na(lblCallWall)
        lblCallWall  := label.new(bar_index + 5, callWall,   "Call Wall $" + str.tostring(callWall),   style=label.style_label_left, color=color.new(#00e676,20), textcolor=color.white, size=size.small)
        lblPutWall   := label.new(bar_index + 5, putWall,    "Put Wall $"  + str.tostring(putWall),    style=label.style_label_left, color=color.new(#ff1744,20), textcolor=color.white, size=size.small)
        lblZeroGamma := label.new(bar_index + 5, zeroGamma,  "Zero Gamma $"+ str.tostring(zeroGamma),  style=label.style_label_left, color=color.new(#ffeb3b,20), textcolor=color.black, size=size.small)
        lblCallStr   := label.new(bar_index + 5, highStrike, "Call Strike $"+str.tostring(highStrike), style=label.style_label_left, color=color.new(#69f0ae,20), textcolor=color.white, size=size.small)
        lblPutStr    := label.new(bar_index + 5, highPutStr, "Put Strike $" +str.tostring(highPutStr), style=label.style_label_left, color=color.new(#ff6d00,20), textcolor=color.white, size=size.small)
    else
        label.set_x(lblCallWall,  bar_index + 5)
        label.set_y(lblCallWall,  callWall)
        label.set_text(lblCallWall, "Call Wall $" + str.tostring(callWall))
        label.set_x(lblPutWall,   bar_index + 5)
        label.set_y(lblPutWall,   putWall)
        label.set_text(lblPutWall, "Put Wall $"  + str.tostring(putWall))
        label.set_x(lblZeroGamma, bar_index + 5)
        label.set_y(lblZeroGamma, zeroGamma)
        label.set_text(lblZeroGamma, "Zero Gamma $"+ str.tostring(zeroGamma))
        label.set_x(lblCallStr,   bar_index + 5)
        label.set_y(lblCallStr,   highStrike)
        label.set_text(lblCallStr, "Call Strike $"+str.tostring(highStrike))
        label.set_x(lblPutStr,    bar_index + 5)
        label.set_y(lblPutStr,    highPutStr)
        label.set_text(lblPutStr, "Put Strike $" +str.tostring(highPutStr))

// ── BACKGROUND: GEX REGIME ZONES ─────────────────────────────────────────────
inGammaCorridor = close >= putWall and close <= callWall
bgcolor(inGammaCorridor ? color.new(color.blue, 97) : na, title="Gamma Corridor")

// ── SIGNAL LOGIC ─────────────────────────────────────────────────────────────
volSMA      = ta.sma(volume, 20)
highVolume  = volume > volSMA or not useVolume

// BEARISH SIGNALS
nearZeroGamma   = math.abs(close - zeroGamma) < (zeroGamma * 0.002)
rejectZeroGamma = close[1] >= zeroGamma and close < zeroGamma and highVolume
breakPutStrike  = close < highPutStr and close[confirmBars] >= highPutStr and highVolume
nearPutWall     = close <= (putWall + (putWall * 0.005)) and close >= putWall and highVolume

// BULLISH SIGNALS
reclaimZeroGamma = close > zeroGamma and close[1] <= zeroGamma and highVolume
bounceCallStrike = close > highStrike and close[confirmBars] <= highStrike and not netGEXneg and highVolume
holdPutStrike    = close > highPutStr and low <= highPutStr and close > open and highVolume

// ── PLOT SIGNALS ─────────────────────────────────────────────────────────────
bearSignal = showSignals and (rejectZeroGamma or breakPutStrike)
bullSignal = showSignals and (reclaimZeroGamma or holdPutStrike)

plotshape(bearSignal, title="SELL Signal", location=location.abovebar,
     style=shape.labeldown, color=color.new(#ff1744, 0), textcolor=color.white,
     text="SELL\n/ES Short", size=size.normal)

plotshape(bullSignal, title="BUY Signal", location=location.belowbar,
     style=shape.labelup, color=color.new(#00e676, 0), textcolor=color.white,
     text="BUY\n/ES Long", size=size.normal)

plotshape(nearPutWall and showSignals, title="Put Wall Warning", location=location.abovebar,
     style=shape.triangledown, color=color.new(#ff6d00, 0), textcolor=color.white,
     text="Put Wall", size=size.small)

// ── INFO TABLE ───────────────────────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 60), border_width=1,
     frame_color=color.new(color.blue, 40), frame_width=2)

if barstate.islast
    regime      = netGEXneg ? "NEGATIVE (Volatile)" : "POSITIVE (Mean-Rev)"
    regimeColor = netGEXneg ? color.new(#ff1744, 40) : color.new(#00e676, 40)
    zeroPos     = zeroAboveSpot ? "Above Spot (Bearish)" : "Below Spot (Bullish)"
    zeroColor   = zeroAboveSpot ? color.new(#ff6d00, 40) : color.new(#69f0ae, 40)

    table.cell(t, 0, 0, "SPY GEX Dashboard",     bgcolor=color.new(#1565c0,20), text_color=color.white, text_size=size.small, text_halign=text.align_center)
    table.cell(t, 1, 0, "As of Market Open",      bgcolor=color.new(#1565c0,20), text_color=color.gray,  text_size=size.tiny,  text_halign=text.align_center)

    table.cell(t, 0, 1, "GEX Regime",    text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 1, regime,          bgcolor=regimeColor,    text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 2, "Zero Gamma",    text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 2, "$" + str.tostring(zeroGamma) + "  " + zeroPos, bgcolor=zeroColor, text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 3, "Call Wall",     text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 3, "$" + str.tostring(callWall),  bgcolor=color.new(#00e676,60), text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 4, "Put Wall",      text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 4, "$" + str.tostring(putWall),   bgcolor=color.new(#ff1744,60), text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 5, "Key Call Strike",text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, "$" + str.tostring(highStrike),bgcolor=color.new(#69f0ae,60), text_color=color.white, text_size=size.tiny)

    table.cell(t, 0, 6, "Key Put Strike", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6, "$" + str.tostring(highPutStr),bgcolor=color.new(#ff6d00,60), text_color=color.white, text_size=size.tiny)

    biasText  = netGEXneg and zeroAboveSpot ? "BEARISH" : "BULLISH"
    biasColor = netGEXneg and zeroAboveSpot ? color.new(#ff1744,30) : color.new(#00e676,30)
    table.cell(t, 0, 7, "Bias",          text_color=color.gray,  text_size=size.tiny)
    table.cell(t, 1, 7, biasText,        bgcolor=biasColor,      text_color=color.white, text_size=size.small)

// ── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bearSignal, "GEX SELL Signal", "SPY GEX: SELL signal - consider /ES short or SPY puts")
alertcondition(bullSignal, "GEX BUY Signal",  "SPY GEX: BUY signal - consider /ES long or SPY calls")
alertcondition(nearPutWall,"GEX Put Wall",    "SPY approaching Put Wall - potential acceleration zone")
