//@version=6
// ============================================================
// Institutional Scalper Pro  v2.0
// "2 Trades Max" Strategy
// — A+ Setup Grading (0–100, fires only at 80+)
// — Max 2 trades per session; "DAILY LIMIT REACHED" guard
// — VWAP + 15-min structural bias
// — Liquidity sweep → pullback → displacement → entry
// — Auto SL/TP1/TP2/TP3/Runner lines on chart
// — Full alert suite (entry, TP1/2/3, SL, sweep, BOS)
// ============================================================
strategy(
     title             = "Institutional Scalper Pro v2.0",
     shorttitle        = "ISP v2.0",
     overlay           = true,
     pyramiding        = 0,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 1,
     initial_capital   = 100000,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.02,
     slippage          = 2,
     calc_on_every_tick      = false,
     process_orders_on_close = true)

// ============================================================
// HELPER FUNCTIONS
// ============================================================

fmtP(float v) =>
    str.tostring(math.round(v, 2))

fmtOk(bool b) =>
    b ? "✓" : "✗"

scoreBar(int s) =>
    s >= 80 ? "A+" : s >= 65 ? "B" : s >= 50 ? "C" : "F"

// Draw a dashed horizontal level with a right-side label
drawLevel(int x0, float price, int ext, color lineCol, color bgCol, color txtCol, string txt) =>
    line.new(x0, price, ext, price,
         color = lineCol, style = line.style_dashed, width = 1)
    label.new(ext, price, txt,
         color     = bgCol,
         textcolor = txtCol,
         style     = label.style_label_left,
         size      = size.small,
         xloc      = xloc.bar_index)

// ============================================================
// INPUTS — Session
// ============================================================

i_useSession = input.bool(true,  "Enable NY AM Session Filter", group = "Session")
i_showSessBG = input.bool(true,  "Shade Session Background",    group = "Session")
i_sesStart   = input.int(930,    "Session Start HHMM EST",      group = "Session", minval = 0, maxval = 2359)
i_sesEnd     = input.int(1130,   "Session End HHMM EST",        group = "Session", minval = 0, maxval = 2359)
i_maxTrades  = input.int(2,      "Max Trades Per Session",       group = "Session", minval = 1, maxval = 5)

// ============================================================
// INPUTS — Structure
// ============================================================

i_nearLen  = input.int(15, "Near Structure Lookback", minval = 5,  maxval = 60,  group = "Structure")
i_farLen   = input.int(40, "Far Structure Lookback",  minval = 10, maxval = 200, group = "Structure")
i_sweepWin = input.int(4,  "Sweep Entry Window (bars)",minval = 1,  maxval = 10,  group = "Structure")

// ============================================================
// INPUTS — Indicators
// ============================================================

i_emaFast   = input.int(9,    "EMA Fast",           minval = 3,  group = "Indicators")
i_emaMid    = input.int(20,   "EMA Mid",            minval = 5,  group = "Indicators")
i_emaSlow   = input.int(50,   "EMA Slow",           minval = 20, group = "Indicators")
i_rsiLen    = input.int(9,    "RSI Length",         minval = 2,  group = "Indicators")
i_atrLen    = input.int(14,   "ATR Length",         minval = 2,  group = "Indicators")
i_atrMult   = input.float(0.5,"ATR Stop Buffer",    minval = 0.1, step = 0.1, group = "Indicators")
i_volLen    = input.int(20,   "Volume MA Length",   minval = 5,  group = "Indicators")
i_volThresh = input.float(1.2,"Vol Spike Threshold",minval = 1.0, step = 0.1, group = "Indicators")
i_displLen  = input.int(3,    "Displacement Window",minval = 1,  maxval = 6,  group = "Indicators")

// ============================================================
// INPUTS — Take Profit
// ============================================================

i_tp1R   = input.float(2.0,  "TP1 R",           minval = 0.5,  step = 0.25, group = "Take Profit")
i_tp2R   = input.float(3.0,  "TP2 R",           minval = 1.0,  step = 0.25, group = "Take Profit")
i_tp3R   = input.float(4.0,  "TP3 R",           minval = 1.5,  step = 0.25, group = "Take Profit")
i_runR   = input.float(6.0,  "Runner R",        minval = 2.0,  step = 0.5,  group = "Take Profit")
i_tp1pct = input.float(50.0, "% exit at TP1",   minval = 10,   maxval = 80, step = 5, group = "Take Profit")
i_tp2pct = input.float(25.0, "% exit at TP2",   minval = 10,   maxval = 60, step = 5, group = "Take Profit")
i_tp3pct = input.float(15.0, "% exit at TP3",   minval = 5,    maxval = 40, step = 5, group = "Take Profit")

// ============================================================
// INPUTS — A+ Score thresholds
// ============================================================

i_minScore  = input.int(80,  "Min Score to Fire Signal", minval = 50, maxval = 100, group = "A+ Score")

// ============================================================
// INPUTS — Visual
// ============================================================

i_showEMAs  = input.bool(true,  "Show EMAs",             group = "Visual")
i_showVWAP  = input.bool(true,  "Show VWAP",             group = "Visual")
i_showStr   = input.bool(true,  "Show Structure Levels", group = "Visual")
i_showSesHL = input.bool(true,  "Show Session H/L",      group = "Visual")
i_showBOS   = input.bool(true,  "Show BOS / CHoCH",      group = "Visual")
i_showSLTP  = input.bool(true,  "Show SL / TP Lines",    group = "Visual")
i_showDash  = input.bool(true,  "Show Dashboard",        group = "Visual")
i_showDebug = input.bool(false, "Show Score Debug",      group = "Visual")

// ============================================================
// BASE INDICATORS
// ============================================================

atr    = ta.atr(i_atrLen)
emaF   = ta.ema(close, i_emaFast)
emaM   = ta.ema(close, i_emaMid)
emaS   = ta.ema(close, i_emaSlow)
rsi    = ta.rsi(close, i_rsiLen)

// Session-anchored VWAP (Pine built-in resets each day)
vwapVal = ta.vwap(hlc3)

avgVol   = ta.sma(volume, i_volLen)
relVol   = volume / math.max(avgVol, 1.0)
volSpike = relVol >= i_volThresh

// ============================================================
// SESSION FILTER
// ============================================================

barHHMM   = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
inSession = not i_useSession or (barHHMM >= i_sesStart and barHHMM < i_sesEnd)

var float sessHigh  = na
var float sessLow   = na
var bool  prevSess  = false

sessOpened = inSession and not prevSess
prevSess  := inSession

if sessOpened
    sessHigh := high
    sessLow  := low
else if inSession
    sessHigh := math.max(sessHigh, high)
    sessLow  := math.min(sessLow,  low)

// ============================================================
// DAILY TRADE COUNTER  (resets when a new session opens)
// ============================================================

var int tradesThisSession = 0

if sessOpened
    tradesThisSession := 0

tradeSlotAvailable = tradesThisSession < i_maxTrades

// ============================================================
// MARKET STRUCTURE  (zero-lag: uses [1] offset so no repainting)
// ============================================================

nearHigh = ta.highest(high, i_nearLen)[1]
nearLow  = ta.lowest (low,  i_nearLen)[1]
farHigh  = ta.highest(high, i_farLen) [1]
farLow   = ta.lowest (low,  i_farLen) [1]

var int  trendDir  = 0
var bool bullBOS   = false
var bool bearBOS   = false
var bool bullCHoCH = false
var bool bearCHoCH = false

bullBOS   := false
bearBOS   := false
bullCHoCH := false
bearCHoCH := false

crossAboveFar = close > farHigh and close[1] <= farHigh
crossBelowFar = close < farLow  and close[1] >= farLow

if crossAboveFar
    if trendDir >= 0
        bullBOS := true
    else
        bullCHoCH := true
    trendDir := 1

if crossBelowFar
    if trendDir <= 0
        bearBOS := true
    else
        bearCHoCH := true
    trendDir := -1

// Liquidity sweep: wick pierces near structure, close reclaims
bullSweep_bar = low  < nearLow  and close > nearLow
bearSweep_bar = high > nearHigh and close < nearHigh

var float lastBullSweepLow  = na
var float lastBearSweepHigh = na

if bullSweep_bar
    lastBullSweepLow := low
if bearSweep_bar
    lastBearSweepHigh := high

recentBullSweep = ta.barssince(bullSweep_bar) <= i_sweepWin
recentBearSweep = ta.barssince(bearSweep_bar) <= i_sweepWin

// Sweep quality: depth of the pierce relative to ATR
sweepDepthBull = bullSweep_bar ? (nearLow - low)    / math.max(atr, 1e-9) : 0.0
sweepDepthBear = bearSweep_bar ? (high - nearHigh)  / math.max(atr, 1e-9) : 0.0

// ============================================================
// DISPLACEMENT CANDLE  (strong engulf-style bar)
// ============================================================

body_   = math.abs(close - open)
range_  = high - low
bullDisp_bar = body_ > atr * 1.2 and close > open and close >= low  + range_ * 0.70
bearDisp_bar = body_ > atr * 1.2 and close < open and close <= high - range_ * 0.70

recentBullDisp = ta.barssince(bullDisp_bar) <= i_displLen
recentBearDisp = ta.barssince(bearDisp_bar) <= i_displLen

// Displacement body size relative to ATR (for scoring)
displStrengthBull = bullDisp_bar ? body_ / math.max(atr, 1e-9) : 0.0
displStrengthBear = bearDisp_bar ? body_ / math.max(atr, 1e-9) : 0.0

// ============================================================
// ESTIMATED DELTA / CVD  (approximated from OHLCV)
// ============================================================

buyEst  = volume * math.max(close - low,   0.0) / math.max(range_, 1e-9)
sellEst = volume * math.max(high  - close, 0.0) / math.max(range_, 1e-9)
delta   = buyEst - sellEst

var float cvd = 0.0
cvd := cvd[1] + delta

deltaPos   = delta > 0
deltaNeg   = delta < 0
cvdBull    = cvd > cvd[3]
cvdBear    = cvd < cvd[3]
deltaFlipP = delta > 0 and delta[1] <= 0
deltaFlipN = delta < 0 and delta[1] >= 0

// ============================================================
// 15-MINUTE HIGHER-TIMEFRAME BIAS
// Pulled via request.security — confirmed HH/HL or LL/LH
// ============================================================

htfClose = request.security(syminfo.tickerid, "15", close, lookahead = barmerge.lookahead_off)
htfHigh  = request.security(syminfo.tickerid, "15", high,  lookahead = barmerge.lookahead_off)
htfLow   = request.security(syminfo.tickerid, "15", low,   lookahead = barmerge.lookahead_off)

htfBull = htfClose > ta.ema(htfClose, 20) and htfHigh > htfHigh[1] and htfLow > htfLow[1]
htfBear = htfClose < ta.ema(htfClose, 20) and htfHigh < htfHigh[1] and htfLow < htfLow[1]

// ============================================================
// VWAP DISTANCE  (normalized, used in score)
// ============================================================

vwapDist      = math.abs(close - vwapVal) / math.max(atr, 1e-9)
nearVWAP      = vwapDist < 1.5          // price is close to VWAP — pullback zone
priceAboveVWAP = close > vwapVal
priceBelowVWAP = close < vwapVal

// VWAP is flat (consolidation guard) — stddev of vwap over 10 bars
vwapMove  = math.abs(vwapVal - vwapVal[5]) / math.max(atr, 1e-9)
vwapFlat  = vwapMove < 0.3

// ============================================================
// ATR EXPANSION
// ============================================================

atrSMA     = ta.sma(atr, 10)
atrExpand  = atr > atrSMA * 0.9          // at least near-average range

// ============================================================
// A+ SETUP SCORING (0 – 100)
// Each factor contributes a fixed number of points
//
// Factor                        Max pts
// ─────────────────────────────────────
// 1. HTF bias aligned              20
// 2. Liquidity sweep present        15
// 3. Sweep depth quality             5
// 4. VWAP reaction (near + side)    15
// 5. Volume expansion               10
// 6. Displacement candle quality    10
// 7. Delta / CVD confirmation       10
// 8. Trend direction (trendDir)      5
// 9. ATR expansion                   5
// 10. RSI momentum alignment         5
// Total                            100
// ============================================================

// Long score
scoreLong() =>
    int s = 0
    // 1. HTF bias
    s += htfBull ? 20 : 0
    // 2. Sweep present
    s += recentBullSweep ? 15 : 0
    // 3. Sweep depth quality (capped at 5)
    float maxDepth = math.max(ta.highest(sweepDepthBull, 10), 0.01)
    s += recentBullSweep ? math.min(math.round(sweepDepthBull / maxDepth * 5), 5) : 0
    // 4. VWAP (above + near)
    s += priceAboveVWAP ? 10 : 0
    s += nearVWAP       ? 5  : 0
    // 5. Volume expansion
    s += volSpike ? 10 : relVol > 1.0 ? 5 : 0
    // 6. Displacement candle
    s += recentBullDisp ? math.min(math.round(displStrengthBull / 2.0 * 10), 10) : 0
    // 7. Delta / CVD
    s += deltaPos   ? 5 : 0
    s += deltaFlipP ? 3 : 0
    s += cvdBull    ? 2 : 0
    // 8. Trend direction
    s += trendDir == 1 ? 5 : trendDir == 0 ? 2 : 0
    // 9. ATR expansion
    s += atrExpand ? 5 : 0
    // 10. RSI momentum
    s += rsi > 50 and rsi > rsi[1] ? 5 : rsi > 45 ? 2 : 0
    s

// Short score
scoreShort() =>
    int s = 0
    // 1. HTF bias
    s += htfBear ? 20 : 0
    // 2. Sweep present
    s += recentBearSweep ? 15 : 0
    // 3. Sweep depth
    float maxDepth = math.max(ta.highest(sweepDepthBear, 10), 0.01)
    s += recentBearSweep ? math.min(math.round(sweepDepthBear / maxDepth * 5), 5) : 0
    // 4. VWAP (below + near)
    s += priceBelowVWAP ? 10 : 0
    s += nearVWAP       ? 5  : 0
    // 5. Volume expansion
    s += volSpike ? 10 : relVol > 1.0 ? 5 : 0
    // 6. Displacement candle
    s += recentBearDisp ? math.min(math.round(displStrengthBear / 2.0 * 10), 10) : 0
    // 7. Delta / CVD
    s += deltaNeg   ? 5 : 0
    s += deltaFlipN ? 3 : 0
    s += cvdBear    ? 2 : 0
    // 8. Trend direction
    s += trendDir == -1 ? 5 : trendDir == 0 ? 2 : 0
    // 9. ATR expansion
    s += atrExpand ? 5 : 0
    // 10. RSI momentum
    s += rsi < 50 and rsi < rsi[1] ? 5 : rsi < 55 ? 2 : 0
    s

rawScoreLong  = scoreLong()
rawScoreShort = scoreShort()

// ============================================================
// HARD FILTERS  (any true = block the trade)
// ============================================================

filterChop     = vwapFlat                        // VWAP flat / choppy
filterNoRange  = not atrExpand                   // below-average range
filterLowVol   = relVol < 0.75                   // thin volume
filterLimit    = not tradeSlotAvailable          // 2-trade cap
filterInPos    = strategy.position_size != 0     // already in a trade

// ============================================================
// SIGNAL CONDITIONS
// ============================================================

noFilter = not filterChop and not filterNoRange and not filterLowVol
           and not filterLimit and not filterInPos

buyCondition  = inSession and recentBullSweep and priceAboveVWAP
     and (recentBullDisp or deltaFlipP)
     and rawScoreLong  >= i_minScore
     and noFilter

sellCondition = inSession and recentBearSweep and priceBelowVWAP
     and (recentBearDisp or deltaFlipN)
     and rawScoreShort >= i_minScore
     and noFilter

buySignal  = buyCondition  and not buyCondition [1]   // edge-trigger
sellSignal = sellCondition and not sellCondition[1]

// ============================================================
// STOP LOSS
// ============================================================

atrBuf = atr * i_atrMult

var float longSL  = na
var float shortSL = na

if buySignal
    float ref = nz(lastBullSweepLow, nearLow)
    longSL   := math.min(ref, low) - atrBuf

if sellSignal
    float ref = nz(lastBearSweepHigh, nearHigh)
    shortSL  := math.max(ref, high) + atrBuf

// ============================================================
// TAKE PROFIT  (calculated from entry close)
// ============================================================

var float lTP1 = na
var float lTP2 = na
var float lTP3 = na
var float lRun = na
var float sTP1 = na
var float sTP2 = na
var float sTP3 = na
var float sRun = na

if buySignal and not na(longSL)
    float r = close - longSL
    lTP1 := close + r * i_tp1R
    lTP2 := close + r * i_tp2R
    lTP3 := close + r * i_tp3R
    lRun := close + r * i_runR

if sellSignal and not na(shortSL)
    float r = shortSL - close
    sTP1 := close - r * i_tp1R
    sTP2 := close - r * i_tp2R
    sTP3 := close - r * i_tp3R
    sRun := close - r * i_runR

// Validate R:R ≥ 2:1 before allowing entry
rrLong  = buySignal  and not na(longSL)  ? (lTP1 - close) / math.max(close - longSL,  1e-9) : 0.0
rrShort = sellSignal and not na(shortSL) ? (close - sTP1) / math.max(shortSL - close, 1e-9) : 0.0

validBuy  = buySignal  and rrLong  >= 1.9
validSell = sellSignal and rrShort >= 1.9

// ============================================================
// STRATEGY EXECUTION
// ============================================================

if validBuy
    strategy.entry("Long",  strategy.long,  comment = "ISP Buy")
    tradesThisSession := tradesThisSession + 1

if validSell
    strategy.entry("Short", strategy.short, comment = "ISP Sell")
    tradesThisSession := tradesThisSession + 1

if strategy.position_size > 0 and not na(longSL)
    strategy.exit("L-TP1", "Long",  qty_percent = i_tp1pct, limit = lTP1, stop = longSL, comment = "TP1")
    strategy.exit("L-TP2", "Long",  qty_percent = i_tp2pct, limit = lTP2, stop = longSL, comment = "TP2")
    strategy.exit("L-TP3", "Long",  qty_percent = i_tp3pct, limit = lTP3, stop = longSL, comment = "TP3")
    strategy.exit("L-Run", "Long",  qty_percent = 100,       limit = lRun,  stop = longSL, comment = "Runner")

if strategy.position_size < 0 and not na(shortSL)
    strategy.exit("S-TP1", "Short", qty_percent = i_tp1pct, limit = sTP1, stop = shortSL, comment = "TP1")
    strategy.exit("S-TP2", "Short", qty_percent = i_tp2pct, limit = sTP2, stop = shortSL, comment = "TP2")
    strategy.exit("S-TP3", "Short", qty_percent = i_tp3pct, limit = sTP3, stop = shortSL, comment = "TP3")
    strategy.exit("S-Run", "Short", qty_percent = 100,       limit = sRun,  stop = shortSL, comment = "Runner")

// ============================================================
// TP / SL HIT DETECTION  (for alerts)
// ============================================================

tp1LongHit  = strategy.position_size[1] > 0 and strategy.position_size < strategy.position_size[1] and close >= lTP1[1]
tp2LongHit  = tp1LongHit and close >= lTP2[1]
tp3LongHit  = tp2LongHit and close >= lTP3[1]
slLongHit   = strategy.position_size[1] > 0 and strategy.position_size == 0 and close <= longSL[1]

tp1ShortHit = strategy.position_size[1] < 0 and strategy.position_size > strategy.position_size[1] and close <= sTP1[1]
tp2ShortHit = tp1ShortHit and close <= sTP2[1]
tp3ShortHit = tp2ShortHit and close <= sTP3[1]
slShortHit  = strategy.position_size[1] < 0 and strategy.position_size == 0 and close >= shortSL[1]

// ============================================================
// VISUAL — base overlays
// ============================================================

bgcolor(i_showSessBG and inSession ? color.new(color.blue, 93) : na, title = "Session BG")

plot(i_showEMAs ? emaF : na, "EMA 9",  color = color.new(color.yellow, 0), linewidth = 1)
plot(i_showEMAs ? emaM : na, "EMA 20", color = color.new(color.orange, 0), linewidth = 1)
plot(i_showEMAs ? emaS : na, "EMA 50", color = color.new(color.red,    0), linewidth = 2)
plot(i_showVWAP ? vwapVal : na, "VWAP",color = color.new(color.purple, 0), linewidth = 2)

plot(i_showSesHL and inSession ? sessHigh : na, "Sess H",
     color = color.new(color.teal,   0), style = plot.style_stepline, linewidth = 1)
plot(i_showSesHL and inSession ? sessLow  : na, "Sess L",
     color = color.new(color.maroon, 0), style = plot.style_stepline, linewidth = 1)

plot(i_showStr ? nearHigh : na, "Near High",
     color = color.new(color.silver, 50), style = plot.style_stepline, linewidth = 1)
plot(i_showStr ? nearLow  : na, "Near Low",
     color = color.new(color.silver, 50), style = plot.style_stepline, linewidth = 1)

// BOS / CHoCH labels
plotshape(i_showBOS and bullBOS,   location = location.belowbar, style = shape.labelup,
     color = color.new(color.lime,    0), text = "BOS",   textcolor = color.black, size = size.tiny)
plotshape(i_showBOS and bearBOS,   location = location.abovebar, style = shape.labeldown,
     color = color.new(color.red,     0), text = "BOS",   textcolor = color.white, size = size.tiny)
plotshape(i_showBOS and bullCHoCH, location = location.belowbar, style = shape.labelup,
     color = color.new(color.aqua,    0), text = "CHoCH", textcolor = color.black, size = size.tiny)
plotshape(i_showBOS and bearCHoCH, location = location.abovebar, style = shape.labeldown,
     color = color.new(color.fuchsia, 0), text = "CHoCH", textcolor = color.white, size = size.tiny)

// Sweep dots
plotshape(bullSweep_bar, location = location.belowbar, style = shape.circle,
     color = color.new(color.lime, 30), size = size.tiny, title = "Bull Sweep")
plotshape(bearSweep_bar, location = location.abovebar, style = shape.circle,
     color = color.new(color.red,  30), size = size.tiny, title = "Bear Sweep")

// ============================================================
// VISUAL — Entry signals with A+ score label
// ============================================================

if validBuy and not na(longSL)
    float riskL = close - longSL
    float rrL   = lTP1 - close
    label.new(bar_index, low - atr * 1.0,
         "▲  BUY\n" + fmtP(close) +
         "\nScore: " + str.tostring(rawScoreLong) + " " + scoreBar(rawScoreLong) +
         "\nSL: "   + fmtP(longSL) +
         "\nRisk: " + fmtP(riskL)  + " pts" +
         "\nR:R: "  + str.tostring(math.round(rrL / math.max(riskL, 1e-9), 1)) + ":1",
         color     = color.new(color.lime, 5),
         textcolor = color.black,
         style     = label.style_label_up,
         size      = size.normal,
         xloc      = xloc.bar_index)

if validSell and not na(shortSL)
    float riskS = shortSL - close
    float rrS   = close - sTP1
    label.new(bar_index, high + atr * 1.0,
         "▼  SELL\n" + fmtP(close) +
         "\nScore: " + str.tostring(rawScoreShort) + " " + scoreBar(rawScoreShort) +
         "\nSL: "   + fmtP(shortSL) +
         "\nRisk: " + fmtP(riskS)   + " pts" +
         "\nR:R: "  + str.tostring(math.round(rrS / math.max(riskS, 1e-9), 1)) + ":1",
         color     = color.new(color.red, 5),
         textcolor = color.white,
         style     = label.style_label_down,
         size      = size.normal,
         xloc      = xloc.bar_index)

// ============================================================
// VISUAL — SL / TP lines
// ============================================================

if i_showSLTP
    int ext = bar_index + 40

    if validBuy and not na(longSL)
        drawLevel(bar_index, longSL, ext,
             color.new(color.red,   0), color.new(color.red,   10), color.white,
             "SL  " + fmtP(longSL))
        drawLevel(bar_index, lTP1, ext,
             color.new(color.lime,  0), color.new(color.lime,  10), color.black,
             "TP1 " + fmtP(lTP1) + " (" + str.tostring(i_tp1R) + "R)")
        drawLevel(bar_index, lTP2, ext,
             color.new(color.green, 0), color.new(color.green, 10), color.white,
             "TP2 " + fmtP(lTP2) + " (" + str.tostring(i_tp2R) + "R)")
        drawLevel(bar_index, lTP3, ext,
             color.new(color.teal,  0), color.new(color.teal,  10), color.white,
             "TP3 " + fmtP(lTP3) + " (" + str.tostring(i_tp3R) + "R)")
        drawLevel(bar_index, lRun, ext,
             color.new(color.aqua,  0), color.new(color.aqua,  10), color.black,
             "RUN " + fmtP(lRun)  + " (" + str.tostring(i_runR)  + "R)")

    if validSell and not na(shortSL)
        drawLevel(bar_index, shortSL, ext,
             color.new(color.red,   0), color.new(color.red,   10), color.white,
             "SL  " + fmtP(shortSL))
        drawLevel(bar_index, sTP1, ext,
             color.new(color.lime,  0), color.new(color.lime,  10), color.black,
             "TP1 " + fmtP(sTP1) + " (" + str.tostring(i_tp1R) + "R)")
        drawLevel(bar_index, sTP2, ext,
             color.new(color.green, 0), color.new(color.green, 10), color.white,
             "TP2 " + fmtP(sTP2) + " (" + str.tostring(i_tp2R) + "R)")
        drawLevel(bar_index, sTP3, ext,
             color.new(color.teal,  0), color.new(color.teal,  10), color.white,
             "TP3 " + fmtP(sTP3) + " (" + str.tostring(i_tp3R) + "R)")
        drawLevel(bar_index, sRun, ext,
             color.new(color.aqua,  0), color.new(color.aqua,  10), color.black,
             "RUN " + fmtP(sRun)  + " (" + str.tostring(i_runR)  + "R)")

// ============================================================
// DASHBOARD
// ============================================================

if i_showDash
    string sesStr  = inSession ? "ACTIVE" : "CLOSED"
    string biasStr = htfBull ? "BULL" : htfBear ? "BEAR" : "UNCLEAR"
    string vwapStr = priceAboveVWAP ? "ABOVE" : "BELOW"
    string volStr  = volSpike ? "SPIKE" : relVol > 1.0 ? "AVG" : "LOW"
    string trendS  = trendDir ==  1 ? "BULL" : trendDir == -1 ? "BEAR" : "NEUT"
    string sweepS  = recentBullSweep ? "BULL ✓" : recentBearSweep ? "BEAR ✓" : "—"
    string posStr  = strategy.position_size > 0 ? "LONG" :
                     strategy.position_size < 0 ? "SHORT" : "FLAT"
    string limitS  = filterLimit ? "⛔ DAILY LIMIT REACHED" :
                     "Trades Left: " + str.tostring(i_maxTrades - tradesThisSession)

    int    tot = strategy.wintrades + strategy.losstrades
    string wrS = tot > 0
         ? str.tostring(math.round(strategy.wintrades / tot * 100, 1)) + "%"
         : "N/A"
    string pfS = strategy.grossloss != 0
         ? str.tostring(math.round(strategy.grossprofit / math.abs(strategy.grossloss), 2))
         : "N/A"

    string lScoreS = "Long Score : " + str.tostring(rawScoreLong)  + " [" + scoreBar(rawScoreLong)  + "]"
    string sScoreS = "Short Score: " + str.tostring(rawScoreShort) + " [" + scoreBar(rawScoreShort) + "]"

    string dash =
         "══ ISP v2.0 ══════════\n" +
         "Session : " + sesStr   + "\n" +
         "15m Bias: " + biasStr  + "\n" +
         "Trend   : " + trendS   + "\n" +
         "VWAP    : " + vwapStr  + "\n" +
         "Volume  : " + volStr   + " (" + str.tostring(math.round(relVol, 2)) + "x)\n" +
         "Sweep   : " + sweepS   + "\n" +
         "──────────────────────\n" +
         lScoreS + "\n" +
         sScoreS + "\n" +
         "──────────────────────\n" +
         limitS + "\n" +
         "Position: " + posStr   + "\n" +
         "Win Rate: " + wrS      + "\n" +
         "Prof Fac: " + pfS      + "\n" +
         "Net PnL : $" + str.tostring(math.round(strategy.netprofit, 2)) + "\n" +
         "══════════════════════"

    var table dashTbl = table.new(position.top_right, 1, 1,
         bgcolor      = color.new(color.black, 5),
         border_color = color.new(color.gray,  20),
         border_width = 1,
         frame_color  = color.new(color.gray,  10),
         frame_width  = 1)
    table.cell(dashTbl, 0, 0, dash,
         text_color = filterLimit ? color.red : color.white,
         text_size  = size.small,
         bgcolor    = color.new(color.black, 10))

// ============================================================
// SCORE DEBUG TABLE  (enable in Visual settings)
// ============================================================

if i_showDebug
    string dbg =
         "── LONG SCORE BREAKDOWN ──\n" +
         fmtOk(htfBull)          + " HTF Bias Bull\n" +
         fmtOk(recentBullSweep)  + " Bull Sweep (" + str.tostring(ta.barssince(bullSweep_bar)) + "b)\n" +
         fmtOk(priceAboveVWAP)   + " Above VWAP\n" +
         fmtOk(nearVWAP)         + " Near VWAP\n" +
         fmtOk(volSpike)         + " Vol Spike (" + str.tostring(math.round(relVol, 2)) + "x)\n" +
         fmtOk(recentBullDisp)   + " Bull Displacement\n" +
         fmtOk(deltaPos)         + " Delta Positive\n" +
         fmtOk(deltaFlipP)       + " Delta Flip +\n" +
         fmtOk(cvdBull)          + " CVD Rising\n" +
         fmtOk(atrExpand)        + " ATR Expanding\n" +
         "Score: " + str.tostring(rawScoreLong) + " / 100  [" + scoreBar(rawScoreLong) + "]\n" +
         "── SHORT SCORE BREAKDOWN ──\n" +
         fmtOk(htfBear)          + " HTF Bias Bear\n" +
         fmtOk(recentBearSweep)  + " Bear Sweep (" + str.tostring(ta.barssince(bearSweep_bar)) + "b)\n" +
         fmtOk(priceBelowVWAP)   + " Below VWAP\n" +
         fmtOk(nearVWAP)         + " Near VWAP\n" +
         fmtOk(volSpike)         + " Vol Spike\n" +
         fmtOk(recentBearDisp)   + " Bear Displacement\n" +
         fmtOk(deltaNeg)         + " Delta Negative\n" +
         fmtOk(deltaFlipN)       + " Delta Flip -\n" +
         fmtOk(cvdBear)          + " CVD Falling\n" +
         fmtOk(atrExpand)        + " ATR Expanding\n" +
         "Score: " + str.tostring(rawScoreShort) + " / 100  [" + scoreBar(rawScoreShort) + "]"

    var table dbgTbl = table.new(position.bottom_left, 1, 1,
         bgcolor      = color.new(color.black, 10),
         border_color = color.new(color.gray,  30),
         border_width = 1)
    table.cell(dbgTbl, 0, 0, dbg,
         text_color = color.white,
         text_size  = size.tiny,
         bgcolor    = color.new(color.black, 15))

// ============================================================
// ALERTS
// ============================================================

// Entry alerts include score and levels
alertcondition(validBuy,
     title   = "ISP ▲ Buy Entry",
     message = "BUY {{ticker}} @ {{close}} | Score: " +
               str.tostring(rawScoreLong) + " | SL: " + fmtP(longSL) +
               " | TP1: " + fmtP(lTP1) + " | TP2: " + fmtP(lTP2) +
               " | TP3: " + fmtP(lTP3) + " | {{time}}")

alertcondition(validSell,
     title   = "ISP ▼ Sell Entry",
     message = "SELL {{ticker}} @ {{close}} | Score: " +
               str.tostring(rawScoreShort) + " | SL: " + fmtP(shortSL) +
               " | TP1: " + fmtP(sTP1) + " | TP2: " + fmtP(sTP2) +
               " | TP3: " + fmtP(sTP3) + " | {{time}}")

alertcondition(tp1LongHit,  title = "ISP Long TP1 Hit",  message = "LONG TP1 hit {{ticker}} @ {{close}}")
alertcondition(tp2LongHit,  title = "ISP Long TP2 Hit",  message = "LONG TP2 hit {{ticker}} @ {{close}}")
alertcondition(tp3LongHit,  title = "ISP Long TP3 Hit",  message = "LONG TP3 hit {{ticker}} @ {{close}}")
alertcondition(slLongHit,   title = "ISP Long SL Hit",   message = "LONG SL HIT {{ticker}} @ {{close}}")

alertcondition(tp1ShortHit, title = "ISP Short TP1 Hit", message = "SHORT TP1 hit {{ticker}} @ {{close}}")
alertcondition(tp2ShortHit, title = "ISP Short TP2 Hit", message = "SHORT TP2 hit {{ticker}} @ {{close}}")
alertcondition(tp3ShortHit, title = "ISP Short TP3 Hit", message = "SHORT TP3 hit {{ticker}} @ {{close}}")
alertcondition(slShortHit,  title = "ISP Short SL Hit",  message = "SHORT SL HIT {{ticker}} @ {{close}}")

alertcondition(bullSweep_bar,       title = "ISP Bull Sweep",    message = "Bull sweep {{ticker}} @ {{close}}")
alertcondition(bearSweep_bar,       title = "ISP Bear Sweep",    message = "Bear sweep {{ticker}} @ {{close}}")
alertcondition(bullBOS,             title = "ISP Bull BOS",      message = "Bull BOS {{ticker}}")
alertcondition(bearBOS,             title = "ISP Bear BOS",      message = "Bear BOS {{ticker}}")
alertcondition(bullCHoCH,           title = "ISP Bull CHoCH",    message = "Bull CHoCH {{ticker}}")
alertcondition(bearCHoCH,           title = "ISP Bear CHoCH",    message = "Bear CHoCH {{ticker}}")
alertcondition(filterLimit,         title = "ISP Daily Limit",   message = "DAILY TRADE LIMIT REACHED {{ticker}}")
