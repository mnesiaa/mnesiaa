// ============================================================
// INSTITUTIONAL SCALPER PRO v1.0
// Pine Script v6 — Strategy + Indicator Combined
// Author: Institutional Scalper Pro
// Optimized for: NQ, ES, SPY, QQQ, BTC, XAUUSD
// Timeframes: 1m, 3m, 5m
// ============================================================
// ARCHITECTURE
//   1. Market Structure (BOS/CHoCH/HH-LL)
//   2. Liquidity Concepts (sweeps, equal H/L, session H/L)
//   3. Smart Money / Order Flow (FVG, displacement, imbalance)
//   4. Volume Analysis (relative volume, absorption, CVD proxy)
//   5. Trend & Momentum Filters (VWAP, EMA 9/20/50, ATR, RSI)
//   6. Session Filter (NY AM 09:30–11:30 EST)
//   7. Signal Logic (BUY/SELL with multi-confirmation gate)
//   8. Stop Loss (structure-based + ATR buffer)
//   9. Take Profit (TP1/TP2/TP3/Runner, R-multiples)
//  10. Backtest Engine (strategy.entry / strategy.exit)
//  11. Visual Dashboard
//  12. Alert Conditions
// ============================================================

//@version=6
strategy(
     title            = "Institutional Scalper Pro v1.0",
     shorttitle       = "ISP v1.0",
     overlay          = true,
     pyramiding       = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value= 10,
     initial_capital  = 100000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.02,
     slippage         = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true
     )

// ─────────────────────────────────────────────
// ░░  INPUTS
// ─────────────────────────────────────────────

// --- Session ---
var string GRP_SESSION = "Session Filter"
i_useSession   = input.bool(true,  "Enable NY AM Session Filter", group=GRP_SESSION)
i_sessionStart = input.session("0930-1130", "NY AM Session (EST)", group=GRP_SESSION)
i_showSession  = input.bool(true,  "Shade Session Background",     group=GRP_SESSION)

// --- Market Structure ---
var string GRP_MS = "Market Structure"
i_swingLen  = input.int(10,  "Swing Lookback Length",    minval=3, maxval=50, group=GRP_MS)
i_bosLen    = input.int(20,  "BOS Confirmation Length",  minval=5, maxval=100, group=GRP_MS)

// --- Fair Value Gap ---
var string GRP_FVG = "Fair Value Gap"
i_fvgEnable = input.bool(true, "Enable FVG Detection",   group=GRP_FVG)
i_fvgMinATR = input.float(0.3, "Min FVG Size (ATR mult)",minval=0.1,step=0.1, group=GRP_FVG)

// --- Volume ---
var string GRP_VOL = "Volume"
i_volLen    = input.int(20,  "Relative Volume Length",   minval=5, group=GRP_VOL)
i_volThresh = input.float(1.5,"Volume Spike Threshold",  minval=1.0,step=0.1, group=GRP_VOL)

// --- Trend Filters ---
var string GRP_TREND = "Trend & Momentum Filters"
i_ema9   = input.int(9,   "EMA Fast",   minval=3,  group=GRP_TREND)
i_ema20  = input.int(20,  "EMA Mid",    minval=5,  group=GRP_TREND)
i_ema50  = input.int(50,  "EMA Slow",   minval=20, group=GRP_TREND)
i_rsiLen = input.int(14,  "RSI Length", minval=2,  group=GRP_TREND)
i_rsiBull= input.int(55,  "RSI Bull Threshold (>)", minval=50, maxval=80, group=GRP_TREND)
i_rsiBear= input.int(45,  "RSI Bear Threshold (<)", minval=20, maxval=50, group=GRP_TREND)
i_atrLen = input.int(14,  "ATR Length", minval=2,  group=GRP_TREND)
i_atrMult= input.float(0.5,"ATR Stop Buffer Mult", minval=0.1,step=0.1, group=GRP_TREND)

// --- Take Profit ---
var string GRP_TP = "Take Profit (R-Multiples)"
i_tp1R   = input.float(1.0, "TP1 (R)",    minval=0.5, step=0.25, group=GRP_TP)
i_tp2R   = input.float(2.0, "TP2 (R)",    minval=1.0, step=0.25, group=GRP_TP)
i_tp3R   = input.float(3.0, "TP3 (R)",    minval=1.5, step=0.25, group=GRP_TP)
i_runR   = input.float(5.0, "Runner (R)", minval=2.0, step=0.5,  group=GRP_TP)
i_tp1pct = input.float(40.0,"% Closed at TP1", minval=10, maxval=80, step=5, group=GRP_TP)
i_tp2pct = input.float(30.0,"% Closed at TP2", minval=10, maxval=60, step=5, group=GRP_TP)
i_tp3pct = input.float(20.0,"% Closed at TP3", minval=5,  maxval=40, step=5, group=GRP_TP)

// --- Display ---
var string GRP_VIZ = "Visual Settings"
i_showEMAs    = input.bool(true,  "Show EMAs",              group=GRP_VIZ)
i_showVWAP    = input.bool(true,  "Show VWAP",              group=GRP_VIZ)
i_showFVG     = input.bool(true,  "Show Fair Value Gaps",   group=GRP_VIZ)
i_showSesHL   = input.bool(true,  "Show Session High/Low",  group=GRP_VIZ)
i_showBOSLine = input.bool(true,  "Show BOS/CHoCH Lines",   group=GRP_VIZ)
i_showDash    = input.bool(true,  "Show Dashboard",         group=GRP_VIZ)
i_showSLTP    = input.bool(true,  "Show SL/TP Lines",       group=GRP_VIZ)

// ─────────────────────────────────────────────
// ░░  CORE CALCULATIONS
// ─────────────────────────────────────────────

// ATR
atr = ta.atr(i_atrLen)

// EMAs
ema9  = ta.ema(close, i_ema9)
ema20 = ta.ema(close, i_ema20)
ema50 = ta.ema(close, i_ema50)

// RSI
rsi = ta.rsi(close, i_rsiLen)

// VWAP (session-anchored)
[vwap_val, _, _] = ta.vwap(hlc3, true, 1)

// Relative Volume
avgVol   = ta.sma(volume, i_volLen)
relVol   = volume / avgVol
volSpike = relVol >= i_volThresh

// ─────────────────────────────────────────────
// ░░  SESSION LOGIC
// ─────────────────────────────────────────────

inSession = not i_useSession or na(time(timeframe.period, i_sessionStart, "America/New_York")) == false

// Track session open bar
var bool  sessionJustOpened = false
var float sessionHigh       = na
var float sessionLow        = na
var int   sessionStartBar   = na

bool prevInSession = inSession[1]
sessionJustOpened := inSession and not prevInSession

if sessionJustOpened
    sessionHigh      := high
    sessionLow       := low
    sessionStartBar  := bar_index
else if inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow  := math.min(sessionLow,  low)

// ─────────────────────────────────────────────
// ░░  SWING HIGH / LOW (confirmed, non-repainting)
// ─────────────────────────────────────────────
// We look BACK i_swingLen bars so signal is confirmed after close.

swingHigh = ta.pivothigh(high, i_swingLen, i_swingLen)
swingLow  = ta.pivotlow (low,  i_swingLen, i_swingLen)

// Track last N confirmed swing points
var float lastSwingHigh   = na
var float lastSwingHigh2  = na  // second-to-last
var float lastSwingLow    = na
var float lastSwingLow2   = na

if not na(swingHigh)
    lastSwingHigh2 := lastSwingHigh
    lastSwingHigh  := swingHigh

if not na(swingLow)
    lastSwingLow2 := lastSwingLow
    lastSwingLow  := swingLow

// ─────────────────────────────────────────────
// ░░  MARKET STRUCTURE — BOS / CHoCH
// ─────────────────────────────────────────────
// BOS  = price closes beyond the LAST swing point in same trend direction
// CHoCH = price closes beyond swing point AGAINST prior trend → reversal

var int   trendDir       = 0   // 1 = bull, -1 = bear, 0 = unknown
var float bosLevel       = na
var bool  bullishBOS     = false
var bool  bearishBOS     = false
var bool  bullishCHoCH   = false
var bool  bearishCHoCH   = false

bullishBOS   := false
bearishBOS   := false
bullishCHoCH := false
bearishCHoCH := false

// Bullish BOS: close above last confirmed swing high
if not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
    if trendDir >= 0
        bullishBOS := true
    else
        bullishCHoCH := true  // was bearish, now reclaiming → CHoCH
    trendDir := 1
    bosLevel := lastSwingHigh

// Bearish BOS: close below last confirmed swing low
if not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
    if trendDir <= 0
        bearishBOS := true
    else
        bearishCHoCH := true
    trendDir := -1
    bosLevel := lastSwingLow

// ─────────────────────────────────────────────
// ░░  LIQUIDITY SWEEP DETECTION
// ─────────────────────────────────────────────
// Sweep = wick pierces a prior swing level but CANDLE CLOSES BACK beyond it

// Bull sweep: low goes below last swing low, close comes back above
bullSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow

// Bear sweep: high goes above last swing high, close comes back below
bearSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

// Equal highs/lows (±0.05% tolerance)
eqTol = close * 0.0005
equalHighs = not na(lastSwingHigh) and not na(lastSwingHigh2) and math.abs(lastSwingHigh - lastSwingHigh2) <= eqTol
equalLows  = not na(lastSwingLow)  and not na(lastSwingLow2)  and math.abs(lastSwingLow  - lastSwingLow2)  <= eqTol

// ─────────────────────────────────────────────
// ░░  FAIR VALUE GAP (FVG) — 3-candle imbalance
// ─────────────────────────────────────────────
// Bullish FVG: low[0] > high[2] (gap between candle -2 top and candle 0 bottom)
// Bearish FVG: high[0] < low[2]
// Minimum size filter using ATR.

minFVGSize = atr * i_fvgMinATR

bullFVG_raw  = low    > high[2] and (low - high[2]) >= minFVGSize
bearFVG_raw  = high   < low[2]  and (low[2] - high) >= minFVGSize

// Store FVG zones for display (track last active zone)
var float bFVG_top = na, var float bFVG_bot = na
var float vFVG_top = na, var float vFVG_bot = na
var bool  bFVG_active = false, var bool  vFVG_active = false

if i_fvgEnable and bullFVG_raw
    bFVG_top    := low
    bFVG_bot    := high[2]
    bFVG_active := true

if i_fvgEnable and bearFVG_raw
    vFVG_top    := low[2]
    vFVG_bot    := high
    vFVG_active := true

// Deactivate when price enters zone
if bFVG_active and close < bFVG_bot
    bFVG_active := false
if vFVG_active and close > vFVG_top
    vFVG_active := false

// Price in / near FVG
priceInBullFVG = bFVG_active and close >= bFVG_bot and close <= bFVG_top
priceInBearFVG = vFVG_active and close >= vFVG_bot and close <= vFVG_top

// ─────────────────────────────────────────────
// ░░  DISPLACEMENT CANDLE (Aggressive momentum)
// ─────────────────────────────────────────────
// A displacement candle is a candle that:
//   - body is larger than 1.5× ATR
//   - closes in upper/lower 25% of its range

bodySize = math.abs(close - open)
range_   = high - low
bullDisplace = bodySize > atr * 1.5 and close > open and close >= low  + range_ * 0.75
bearDisplace = bodySize > atr * 1.5 and close < open and close <= high - range_ * 0.75

// ─────────────────────────────────────────────
// ░░  CVD APPROXIMATION (delta proxy)
// ─────────────────────────────────────────────
// Approximate buy/sell volume via price position in candle range
buyVolEst  = volume * ((close - low)  / math.max(high - low, 0.000001))
sellVolEst = volume * ((high - close) / math.max(high - low, 0.000001))
delta      = buyVolEst - sellVolEst

var float cvd = 0.0
cvd := cvd[1] + delta
cvdRising  = cvd > cvd[i_volLen]
cvdFalling = cvd < cvd[i_volLen]

// ─────────────────────────────────────────────
// ░░  TREND FILTERS
// ─────────────────────────────────────────────
// EMA alignment
emaBull = ema9 > ema20 and ema20 > ema50
emaBear = ema9 < ema20 and ema20 < ema50

// VWAP bias
vwapBull = close > vwap_val
vwapBear = close < vwap_val

// ATR volatility (avoid flat/dead markets)
atrNorm       = atr / close * 100        // ATR as % of price
minVolatility = atrNorm > 0.03           // at least 3 bps volatility

// RSI momentum
rsiBull_ok = rsi > i_rsiBull
rsiBear_ok = rsi < i_rsiBear

// ─────────────────────────────────────────────
// ░░  FAKEOUT / CHOP FILTER
// ─────────────────────────────────────────────
// Avoid entries when:
//   - Range is < 0.5× ATR (extremely tight candle)
//   - Volume is below average
//   - Price has already moved > 3R from structure (overextended)
//   - RSI is in neutral zone (45–55) and no strong displacement

choppyRange  = (high - low) < atr * 0.5
lowVolume    = volume < avgVol * 0.8
neutralMom   = rsi >= i_rsiBear and rsi <= i_rsiBull
noDisplace   = not bullDisplace and not bearDisplace

chopFilter   = choppyRange or lowVolume or (neutralMom and noDisplace)

// ─────────────────────────────────────────────
// ░░  SIGNAL LOGIC
// ─────────────────────────────────────────────

// ── BUY SIGNAL CONDITIONS ──────────────────
// 1. In active session
// 2. Bullish structure (BOS or CHoCH) OR trend is already bull
// 3. Liquidity sweep below lows (stop hunt)
// 4. Strong reclaim above VWAP
// 5. Volume expansion confirmed
// 6. Bullish displacement OR price entering bullish FVG
// 7. EMA alignment (at least ema9 > ema20)
// 8. RSI above threshold
// 9. No chop filter triggered
// 10. CVD rising (buy pressure increasing)

structureBull = (bullishBOS or bullishCHoCH or trendDir == 1)
reclaim_bull  = close > vwap_val and vwap_val[1] >= close[1]  // reclaimed VWAP this bar

buyCondition = inSession
     and structureBull
     and bullSweep
     and vwapBull
     and volSpike
     and (bullDisplace or priceInBullFVG)
     and (ema9 > ema20)
     and rsiBull_ok
     and not chopFilter
     and cvdRising
     and minVolatility

// ── SELL SIGNAL CONDITIONS ─────────────────
structureBear = (bearishBOS or bearishCHoCH or trendDir == -1)
reclaim_bear  = close < vwap_val and vwap_val[1] <= close[1]

sellCondition = inSession
     and structureBear
     and bearSweep
     and vwapBear
     and volSpike
     and (bearDisplace or priceInBearFVG)
     and (ema9 < ema20)
     and rsiBear_ok
     and not chopFilter
     and cvdFalling
     and minVolatility

// Ensure signals only on confirmed candle close (process_orders_on_close=true handles this)
// Gate: no active trade already open
noActiveTrade = strategy.position_size == 0

buySignal  = buyCondition  and noActiveTrade
sellSignal = sellCondition and noActiveTrade

// ─────────────────────────────────────────────
// ░░  STOP LOSS CALCULATION
// ─────────────────────────────────────────────
// Place SL beyond the liquidity sweep wick + ATR buffer

atrBuffer = atr * i_atrMult

var float longSL  = na
var float shortSL = na

if buySignal
    // SL = below the sweep low (the wick that swept lows) + buffer
    longSL := math.min(low, lastSwingLow) - atrBuffer

if sellSignal
    // SL = above the sweep high + buffer
    shortSL := math.max(high, lastSwingHigh) + atrBuffer

// ─────────────────────────────────────────────
// ░░  TAKE PROFIT CALCULATION
// ─────────────────────────────────────────────

var float entryPrice = na
var float longTP1    = na, var float longTP2 = na
var float longTP3    = na, var float longRun = na
var float shortTP1   = na, var float shortTP2 = na
var float shortTP3   = na, var float shortRun = na

if buySignal
    entryPrice := close
    float riskL  = close - longSL
    longTP1 := close + riskL * i_tp1R
    longTP2 := close + riskL * i_tp2R
    longTP3 := close + riskL * i_tp3R
    longRun := close + riskL * i_runR

if sellSignal
    entryPrice := close
    float riskS  = shortSL - close
    shortTP1 := close - riskS * i_tp1R
    shortTP2 := close - riskS * i_tp2R
    shortTP3 := close - riskS * i_tp3R
    shortRun := close - riskS * i_runR

// ─────────────────────────────────────────────
// ░░  STRATEGY EXECUTION
// ─────────────────────────────────────────────

// Long entries
if buySignal
    strategy.entry("Long", strategy.long, comment="ISP Buy")

// Short entries
if sellSignal
    strategy.entry("Short", strategy.short, comment="ISP Sell")

// Long exits — partial closes at TP levels + full stop
if strategy.position_size > 0 and not na(longSL)
    strategy.exit("L-TP1",  "Long", qty_percent=i_tp1pct,
         limit=longTP1, stop=longSL, comment="TP1")
    strategy.exit("L-TP2",  "Long", qty_percent=i_tp2pct,
         limit=longTP2, stop=longSL, comment="TP2")
    strategy.exit("L-TP3",  "Long", qty_percent=i_tp3pct,
         limit=longTP3, stop=longSL, comment="TP3")
    strategy.exit("L-Run",  "Long", qty_percent=100,
         limit=longRun,  stop=longSL, comment="Runner")

// Short exits
if strategy.position_size < 0 and not na(shortSL)
    strategy.exit("S-TP1",  "Short", qty_percent=i_tp1pct,
         limit=shortTP1, stop=shortSL, comment="TP1")
    strategy.exit("S-TP2",  "Short", qty_percent=i_tp2pct,
         limit=shortTP2, stop=shortSL, comment="TP2")
    strategy.exit("S-TP3",  "Short", qty_percent=i_tp3pct,
         limit=shortTP3, stop=shortSL, comment="TP3")
    strategy.exit("S-Run",  "Short", qty_percent=100,
         limit=shortRun,  stop=shortSL, comment="Runner")

// ─────────────────────────────────────────────
// ░░  VISUAL LAYER
// ─────────────────────────────────────────────

// Session background
bgcolor(i_showSession and inSession ? color.new(color.blue, 93) : na, title="Session BG")

// EMAs
plot(i_showEMAs ? ema9  : na, "EMA 9",  color=color.new(color.yellow,  0), linewidth=1)
plot(i_showEMAs ? ema20 : na, "EMA 20", color=color.new(color.orange,  0), linewidth=1)
plot(i_showEMAs ? ema50 : na, "EMA 50", color=color.new(color.red,     0), linewidth=2)

// VWAP
plot(i_showVWAP ? vwap_val : na, "VWAP", color=color.new(color.purple, 0), linewidth=2)

// Session High / Low
plot(i_showSesHL and inSession ? sessionHigh : na, "Sess High", color=color.new(color.teal,   0), style=plot.style_stepline, linewidth=1)
plot(i_showSesHL and inSession ? sessionLow  : na, "Sess Low",  color=color.new(color.maroon, 0), style=plot.style_stepline, linewidth=1)

// BOS / CHoCH labels
plotshape(i_showBOSLine and bullishBOS,   style=shape.labelup,   location=location.belowbar, color=color.new(color.lime,   0), text="BOS",   textcolor=color.black, size=size.tiny, title="Bull BOS")
plotshape(i_showBOSLine and bearishBOS,   style=shape.labeldown, location=location.abovebar, color=color.new(color.red,    0), text="BOS",   textcolor=color.white, size=size.tiny, title="Bear BOS")
plotshape(i_showBOSLine and bullishCHoCH, style=shape.labelup,   location=location.belowbar, color=color.new(color.aqua,   0), text="CHoCH", textcolor=color.black, size=size.tiny, title="Bull CHoCH")
plotshape(i_showBOSLine and bearishCHoCH, style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia,0), text="CHoCH", textcolor=color.white, size=size.tiny, title="Bear CHoCH")

// FVG Boxes — use lines to draw zone borders (boxes require bar-index tracking)
var line fvgBullTop = na, var line fvgBullBot = na
var line fvgBearTop = na, var line fvgBearBot = na

if i_showFVG and i_fvgEnable and bullFVG_raw
    fvgBullTop := line.new(bar_index, bFVG_top, bar_index + 20, bFVG_top, color=color.new(color.green, 50), style=line.style_dashed, width=1)
    fvgBullBot := line.new(bar_index, bFVG_bot, bar_index + 20, bFVG_bot, color=color.new(color.green, 50), style=line.style_dashed, width=1)

if i_showFVG and i_fvgEnable and bearFVG_raw
    fvgBearTop := line.new(bar_index, vFVG_top, bar_index + 20, vFVG_top, color=color.new(color.red,   50), style=line.style_dashed, width=1)
    fvgBearBot := line.new(bar_index, vFVG_bot, bar_index + 20, vFVG_bot, color=color.new(color.red,   50), style=line.style_dashed, width=1)

// Buy / Sell arrows
plotshape(buySignal,  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.normal, title="Buy Signal")
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.normal, title="Sell Signal")

// SL / TP lines on signal bars
var line slLine   = na, var line tp1Line  = na
var line tp2Line  = na, var line tp3Line  = na, var line runLine  = na

drawTPLines(float entry_, float sl_, float tp1_, float tp2_, float tp3_, float run_, bool isBuy) =>
    col_sl  = color.new(color.red,   20)
    col_tp1 = color.new(color.lime,  20)
    col_tp2 = color.new(color.green, 20)
    col_tp3 = color.new(color.teal,  20)
    col_run = color.new(color.aqua,  20)
    ext     = bar_index + 30
    line.new(bar_index, sl_,   ext, sl_,   color=col_sl,  style=line.style_dashed, width=1)
    line.new(bar_index, tp1_,  ext, tp1_,  color=col_tp1, style=line.style_dashed, width=1)
    line.new(bar_index, tp2_,  ext, tp2_,  color=col_tp2, style=line.style_dashed, width=1)
    line.new(bar_index, tp3_,  ext, tp3_,  color=col_tp3, style=line.style_dashed, width=1)
    line.new(bar_index, run_,  ext, run_,  color=col_run, style=line.style_dashed, width=1)

if i_showSLTP and buySignal and not na(longSL)
    drawTPLines(close, longSL, longTP1, longTP2, longTP3, longRun, true)

if i_showSLTP and sellSignal and not na(shortSL)
    drawTPLines(close, shortSL, shortTP1, shortTP2, shortTP3, shortRun, false)

// ─────────────────────────────────────────────
// ░░  DASHBOARD
// ─────────────────────────────────────────────

if i_showDash
    // Build status strings
    string trendStr  = trendDir == 1  ? "▲ BULL"  : trendDir == -1 ? "▼ BEAR" : "── NEUT"
    string sessStr   = inSession       ? "✔ ACTIVE" : "✖ OFF"
    string volStr    = volSpike        ? "HIGH"     : relVol > 1.0 ? "NORM" : "LOW"
    string vwapStr   = vwapBull        ? "ABOVE"    : "BELOW"
    string rsiStr    = str.tostring(math.round(rsi, 1))
    string emaStr    = emaBull         ? "ALIGNED ▲" : emaBear ? "ALIGNED ▼" : "MIXED"
    string atrStr    = str.tostring(math.round(atr, 4))
    string posStr    = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    string winStr    = strategy.wintrades > 0 or strategy.losstrades > 0
         ? str.tostring(math.round(strategy.wintrades / (strategy.wintrades + strategy.losstrades) * 100, 1)) + "%"
         : "N/A"
    string pfStr     = strategy.grossprofit > 0 and strategy.grossloss > 0
         ? str.tostring(math.round(strategy.grossprofit / strategy.grossloss, 2))
         : "N/A"
    string netPnlStr = "$" + str.tostring(math.round(strategy.netprofit, 2))

    dashText = "═══ ISP DASHBOARD ═══\n"
         + "Trend   : " + trendStr + "\n"
         + "Session : " + sessStr  + "\n"
         + "VWAP    : " + vwapStr  + "\n"
         + "Volume  : " + volStr   + " (" + str.tostring(math.round(relVol, 2)) + "x)\n"
         + "RSI     : " + rsiStr   + "\n"
         + "EMA     : " + emaStr   + "\n"
         + "ATR     : " + atrStr   + "\n"
         + "─────────────────────\n"
         + "Position: " + posStr   + "\n"
         + "Win Rate: " + winStr   + "\n"
         + "Prof Fac: " + pfStr    + "\n"
         + "Net P&L : " + netPnlStr

    var table dash = table.new(position.top_right, 1, 1, bgcolor=color.new(color.black, 10), border_color=color.new(color.gray, 30), border_width=1, frame_color=color.new(color.gray, 20), frame_width=1)
    table.cell(dash, 0, 0, dashText,
         text_color=color.new(color.white, 0),
         text_size=size.small,
         bgcolor=color.new(color.black, 15))

// ─────────────────────────────────────────────
// ░░  ALERT CONDITIONS
// ─────────────────────────────────────────────

alertcondition(buySignal,  title="ISP — Buy Signal",  message="ISP Buy Signal fired | {{ticker}} @ {{close}} | Time: {{time}}")
alertcondition(sellSignal, title="ISP — Sell Signal", message="ISP Sell Signal fired | {{ticker}} @ {{close}} | Time: {{time}}")

alertcondition(bullishBOS,   title="ISP — Bullish BOS",   message="Bullish Break of Structure | {{ticker}} @ {{close}}")
alertcondition(bearishBOS,   title="ISP — Bearish BOS",   message="Bearish Break of Structure | {{ticker}} @ {{close}}")
alertcondition(bullishCHoCH, title="ISP — Bullish CHoCH", message="Bullish Change of Character | {{ticker}} @ {{close}}")
alertcondition(bearishCHoCH, title="ISP — Bearish CHoCH", message="Bearish Change of Character | {{ticker}} @ {{close}}")

alertcondition(bullSweep, title="ISP — Liquidity Sweep Low",  message="Liq sweep below lows | {{ticker}} @ {{close}}")
alertcondition(bearSweep, title="ISP — Liquidity Sweep High", message="Liq sweep above highs | {{ticker}} @ {{close}}")

alertcondition(trendDir == 1  and trendDir[1] != 1,  title="ISP — Trend Flipped Bull", message="Trend bias changed to BULLISH | {{ticker}}")
alertcondition(trendDir == -1 and trendDir[1] != -1, title="ISP — Trend Flipped Bear", message="Trend bias changed to BEARISH | {{ticker}}")

