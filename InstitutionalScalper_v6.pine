//@version=6
strategy(
     title                  = "Institutional Scalper Pro v1.5",
     shorttitle             = "ISP v1.5",
     overlay                = true,
     pyramiding             = 0,
     default_qty_type       = strategy.percent_of_equity,
     default_qty_value      = 10,
     initial_capital        = 100000,
     commission_type        = strategy.commission.percent,
     commission_value       = 0.02,
     slippage               = 2,
     max_lines_count        = 500,
     max_labels_count       = 500,
     calc_on_every_tick     = false,
     process_orders_on_close = true)

// ══════════════════════════════════════════════════════════════════════════════
// HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

fmtP(float v) =>
    str.tostring(math.round(v, 2))

fmtOk(bool b) =>
    b ? "[Y]" : "[N]"

drawLevel(x0, price, ext, lnCol, bgCol, txCol, txt) =>
    line.new(x0, price, ext, price, color = lnCol, style = line.style_dashed, width = 1)
    label.new(ext, price, txt,
         color     = bgCol,
         textcolor = txCol,
         style     = label.style_label_left,
         size      = size.small,
         xloc      = xloc.bar_index)

// ══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ── Session ──
grpSes        = "Session"
i_useSession  = input.bool(true,  "Enable NY AM Session Filter",  group = grpSes)
i_showSessBG  = input.bool(true,  "Shade Session Background",     group = grpSes)
i_sesStart    = input.int(930,    "Session Start HHMM EST",       group = grpSes)
i_sesEnd      = input.int(1130,   "Session End HHMM EST",         group = grpSes)
i_sesEntryEnd = input.int(1115,   "Last Entry HHMM EST",          group = grpSes)

// ── Structure ──
grpStr     = "Structure"
i_nearLen  = input.int(15, "Near Structure Lookback", minval = 5,  maxval = 60,  group = grpStr)
i_farLen   = input.int(40, "Far Structure Lookback",  minval = 10, maxval = 200, group = grpStr)
i_sweepWin = input.int(3,  "Sweep Entry Window bars", minval = 1,  maxval = 8,   group = grpStr)

// ── Fair Value Gap ──
grpFVG      = "Fair Value Gap"
i_fvgOn     = input.bool(true,  "Enable FVG",            group = grpFVG)
i_fvgMinATR = input.float(0.2,  "Min FVG Size ATR mult", minval = 0.05, step = 0.05, group = grpFVG)
i_fvgWin    = input.int(4,      "FVG Valid Window bars", minval = 1,    maxval = 10,  group = grpFVG)

// ── Volume ──
grpVol      = "Volume"
i_volLen    = input.int(20,    "Rel-Vol Lookback",    minval = 5,   group = grpVol)
i_volThresh = input.float(1.2, "Vol Spike Threshold", minval = 1.0, step = 0.1, group = grpVol)

// ── Indicators ──
grpInd       = "Indicators"
i_emaFast    = input.int(9,     "EMA Fast",             minval = 3,  group = grpInd)
i_emaMid     = input.int(20,    "EMA Mid",              minval = 5,  group = grpInd)
i_emaSlow    = input.int(50,    "EMA Slow display",     minval = 20, group = grpInd)
i_rsiLen     = input.int(9,     "RSI Length",           minval = 2,  group = grpInd)
i_rsiBullMin = input.int(45,    "RSI Min for Longs",    minval = 30, maxval = 65, group = grpInd)
i_rsiBearMax = input.int(55,    "RSI Max for Shorts",   minval = 35, maxval = 70, group = grpInd)
i_atrLen     = input.int(14,    "ATR Length",           minval = 2,  group = grpInd)
i_atrMult    = input.float(0.5, "ATR Stop Buffer mult", minval = 0.1, step = 0.1, group = grpInd)
i_displLen   = input.int(3,     "Displacement Window",  minval = 1,  maxval = 6,  group = grpInd)

// ── VWAP ──
grpVWAP         = "VWAP"
i_vwapBandFilt  = input.bool(true, "VWAP Band Exhaustion Filter", group = grpVWAP)
i_showVWAPBands = input.bool(true, "Show VWAP SD Bands",          group = grpVWAP)

// ── Volume Profile ──
grpVP       = "Volume Profile"
i_vpOn      = input.bool(true, "Enable Volume Profile", group = grpVP)
i_vpBins    = input.int(24,    "VP Bins",  minval = 10, maxval = 48, group = grpVP)
i_vpPOCFilt = input.bool(true, "POC Proximity Filter",  group = grpVP)
i_showVP    = input.bool(true, "Show POC / VAH / VAL",  group = grpVP)

// ── Filters ──
grpFilt   = "Filters"
i_adxOn   = input.bool(true,   "ADX Trend Strength Filter",   group = grpFilt)
i_adxLen  = input.int(14,      "ADX Length",  minval = 5,     group = grpFilt)
i_adxMin  = input.float(20.0,  "ADX Minimum", minval = 10.0, step = 5.0, group = grpFilt)
i_minRisk = input.float(0.25,  "Min Risk (ATR mult)", minval = 0.05, step = 0.05, group = grpFilt)

// ── Take Profit ──
grpTP    = "Take Profit"
i_tp1R   = input.float(1.0,  "TP1 R",           minval = 0.5,  step = 0.25, group = grpTP)
i_tp2R   = input.float(2.0,  "TP2 R",           minval = 1.0,  step = 0.25, group = grpTP)
i_tp3R   = input.float(3.0,  "TP3 R",           minval = 1.5,  step = 0.25, group = grpTP)
i_runR   = input.float(5.0,  "Runner R",        minval = 2.0,  step = 0.5,  group = grpTP)
i_tp1pct = input.float(40.0, "Pct exit at TP1", minval = 10.0, maxval = 80.0, step = 5.0, group = grpTP)
i_tp2pct = input.float(30.0, "Pct exit at TP2", minval = 10.0, maxval = 60.0, step = 5.0, group = grpTP)
i_tp3pct = input.float(20.0, "Pct exit at TP3", minval = 5.0,  maxval = 40.0, step = 5.0, group = grpTP)

// ── Visual ──
grpVis      = "Visual"
i_showEMAs  = input.bool(true,  "Show EMAs",             group = grpVis)
i_showVWAP  = input.bool(true,  "Show VWAP",             group = grpVis)
i_showFVG   = input.bool(true,  "Show FVG Zones",        group = grpVis)
i_showStr   = input.bool(true,  "Show Structure Levels", group = grpVis)
i_showSesHL = input.bool(true,  "Show Session HL",       group = grpVis)
i_showBOS   = input.bool(true,  "Show BOS / CHoCH",      group = grpVis)
i_showSLTP  = input.bool(true,  "Show SL / TP Lines",    group = grpVis)
i_showDash  = input.bool(true,  "Show Dashboard",        group = grpVis)
i_showDebug = input.bool(false, "Show Condition Debug",  group = grpVis)

// ══════════════════════════════════════════════════════════════════════════════
// BASE INDICATORS
// ══════════════════════════════════════════════════════════════════════════════

atr  = ta.atr(i_atrLen)
emaF = ta.ema(close, i_emaFast)
emaM = ta.ema(close, i_emaMid)
emaS = ta.ema(close, i_emaSlow)
rsi  = ta.rsi(close, i_rsiLen)

vwap_val = ta.vwap(hlc3)
avgVol   = ta.sma(volume, i_volLen)
relVol   = volume / avgVol
volSpike = relVol >= i_volThresh

[_diPlus, _diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)

// ══════════════════════════════════════════════════════════════════════════════
// SESSION FILTER
// ══════════════════════════════════════════════════════════════════════════════

barHHMM    = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
inSession  = not i_useSession or (barHHMM >= i_sesStart  and barHHMM < i_sesEnd)
inEntryWin = not i_useSession or (barHHMM >= i_sesStart  and barHHMM < i_sesEntryEnd)

var float sessionHigh = na
var float sessionLow  = na
var bool  prevSess    = false

sessOpened = inSession and not prevSess
prevSess  := inSession

if sessOpened
    sessionHigh := high
    sessionLow  := low
else if inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow  := math.min(sessionLow,  low)

// ══════════════════════════════════════════════════════════════════════════════
// VWAP STANDARD DEVIATION BANDS
// Session-anchored. Variance = E[P²] − E[P]², volume-weighted.
// ══════════════════════════════════════════════════════════════════════════════

var float _vPV  = 0.0
var float _vPV2 = 0.0
var float _vVol = 0.0

if sessOpened
    _vPV  := 0.0
    _vPV2 := 0.0
    _vVol := 0.0

if inSession
    _vPV  := _vPV  + hlc3 * volume
    _vPV2 := _vPV2 + hlc3 * hlc3 * volume
    _vVol := _vVol + volume

vwapSD = _vVol > 0.0 ? math.sqrt(math.max(_vPV2 / _vVol - vwap_val * vwap_val, 0.0)) : 0.0
vwapU1 = vwap_val + vwapSD
vwapU2 = vwap_val + vwapSD * 2.0
vwapD1 = vwap_val - vwapSD
vwapD2 = vwap_val - vwapSD * 2.0

// ══════════════════════════════════════════════════════════════════════════════
// SESSION VOLUME PROFILE
// Fixed grid anchored at session open ± 3×ATR. Outputs: POC, VAH, VAL.
// ══════════════════════════════════════════════════════════════════════════════

var float[] _vpArr = array.new_float(50, 0.0)
var float   _vpBase = na
var float   _vpBinZ = na
var float   vpPOC   = na
var float   vpVAH   = na
var float   vpVAL   = na

if sessOpened
    array.fill(_vpArr, 0.0)
    _vpBase := open - 3.0 * atr
    _vpBinZ := 6.0  * atr / float(i_vpBins)
    vpPOC   := na
    vpVAH   := na
    vpVAL   := na

if i_vpOn and inSession and not na(_vpBinZ) and _vpBinZ > 0.0
    int   bLo = int(math.max(0.0, math.min(float(i_vpBins - 1), math.floor((low  - _vpBase) / _vpBinZ))))
    int   bHi = int(math.max(0.0, math.min(float(i_vpBins - 1), math.floor((high - _vpBase) / _vpBinZ))))
    float vpb = volume / math.max(float(bHi - bLo + 1), 1.0)

    for i = bLo to bHi
        array.set(_vpArr, i, array.get(_vpArr, i) + vpb)

    int   pocIdx = 0
    float maxV   = 0.0
    float totV   = 0.0

    for i = 0 to i_vpBins - 1
        float v = array.get(_vpArr, i)
        totV += v
        if v > maxV
            maxV   := v
            pocIdx := i

    vpPOC := _vpBase + (float(pocIdx) + 0.5) * _vpBinZ

    float vaBuilt  = maxV
    int   vaLo     = pocIdx
    int   vaHi     = pocIdx
    float vaTarget = totV * 0.70

    for _j = 0 to i_vpBins
        if vaBuilt >= vaTarget
            break
        float addHi = vaHi < i_vpBins - 1 ? array.get(_vpArr, vaHi + 1) : 0.0
        float addLo = vaLo > 0             ? array.get(_vpArr, vaLo - 1) : 0.0
        if addHi >= addLo and vaHi < i_vpBins - 1
            vaHi    += 1
            vaBuilt += addHi
        else if vaLo > 0
            vaLo    -= 1
            vaBuilt += addLo
        else
            break

    vpVAH := _vpBase + float(vaHi + 1) * _vpBinZ
    vpVAL := _vpBase + float(vaLo)     * _vpBinZ

// ══════════════════════════════════════════════════════════════════════════════
// ROLLING STRUCTURE  (zero-lag, non-repainting — [1] offset on closed bars)
// ══════════════════════════════════════════════════════════════════════════════

nearHigh = ta.highest(high, i_nearLen)[1]
nearLow  = ta.lowest (low,  i_nearLen)[1]
farHigh  = ta.highest(high, i_farLen) [1]
farLow   = ta.lowest (low,  i_farLen) [1]

var int  trendDir  = 0
var bool bullBOS   = false
var bool bearBOS   = false
var bool bullCHoCH = false
var bool bearCHoCH = false

bullBOS   := false
bearBOS   := false
bullCHoCH := false
bearCHoCH := false

crossAboveFar = close > farHigh and close[1] <= farHigh
crossBelowFar = close < farLow  and close[1] >= farLow

if crossAboveFar
    if trendDir >= 0
        bullBOS := true
    else
        bullCHoCH := true
    trendDir := 1

if crossBelowFar
    if trendDir <= 0
        bearBOS := true
    else
        bearCHoCH := true
    trendDir := -1

bullSweep_bar = low  < nearLow  and close > nearLow
bearSweep_bar = high > nearHigh and close < nearHigh

var float lastBullSweepLow  = na
var float lastBearSweepHigh = na

if bullSweep_bar
    lastBullSweepLow := low
if bearSweep_bar
    lastBearSweepHigh := high

recentBullSweep = ta.barssince(bullSweep_bar) <= i_sweepWin
recentBearSweep = ta.barssince(bearSweep_bar) <= i_sweepWin

// ══════════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAP  (3-candle imbalance)
// ══════════════════════════════════════════════════════════════════════════════

minFVG      = atr * i_fvgMinATR
bullFVG_bar = low  > high[2] and (low    - high[2]) >= minFVG
bearFVG_bar = high < low[2]  and (low[2] - high)    >= minFVG

var float bFVG_top = na
var float bFVG_bot = na
var bool  bFVG_on  = false
var float vFVG_top = na
var float vFVG_bot = na
var bool  vFVG_on  = false

if i_fvgOn and bullFVG_bar
    bFVG_top := low
    bFVG_bot := high[2]
    bFVG_on  := true

if i_fvgOn and bearFVG_bar
    vFVG_top := low[2]
    vFVG_bot := high
    vFVG_on  := true

if bFVG_on and close < bFVG_bot
    bFVG_on := false
if vFVG_on and close > vFVG_top
    vFVG_on := false

inBullFVG     = bFVG_on and close >= bFVG_bot and close <= bFVG_top
inBearFVG     = vFVG_on and close >= vFVG_bot and close <= vFVG_top
recentBullFVG = ta.barssince(bullFVG_bar) <= i_fvgWin
recentBearFVG = ta.barssince(bearFVG_bar) <= i_fvgWin

// ══════════════════════════════════════════════════════════════════════════════
// DISPLACEMENT CANDLE
// ══════════════════════════════════════════════════════════════════════════════

body   = math.abs(close - open)
range_ = high - low

bullDisp_bar = body > atr * 1.3 and close > open and close >= low  + range_ * 0.70
bearDisp_bar = body > atr * 1.3 and close < open and close <= high - range_ * 0.70

recentBullDisp = ta.barssince(bullDisp_bar) <= i_displLen
recentBearDisp = ta.barssince(bearDisp_bar) <= i_displLen

// ══════════════════════════════════════════════════════════════════════════════
// DELTA / CVD  (buy-sell volume approximation from candle position)
// ══════════════════════════════════════════════════════════════════════════════

rangeG  = math.max(range_, 1e-9)
buyEst  = volume * math.max(close - low,   0.0) / rangeG
sellEst = volume * math.max(high  - close, 0.0) / rangeG
delta   = buyEst - sellEst

var float cvd = 0.0
cvd := cvd[1] + delta

deltaPos = delta > 0.0
deltaNeg = delta < 0.0
cvdUp    = cvd > cvd[3]
cvdDown  = cvd < cvd[3]

// ══════════════════════════════════════════════════════════════════════════════
// TREND / MOMENTUM FILTERS
// ══════════════════════════════════════════════════════════════════════════════

emaBull  = emaF > emaM
emaBear  = emaF < emaM
vwapBull = close > vwap_val
vwapBear = close < vwap_val
rsiBull  = rsi > i_rsiBullMin and rsi > rsi[1]
rsiBear  = rsi < i_rsiBearMax and rsi < rsi[1]
atrOk    = (high - low) > atr * 0.35
volOk    = volume > avgVol * 0.75

// ══════════════════════════════════════════════════════════════════════════════
// ADDITIONAL FILTERS
// ══════════════════════════════════════════════════════════════════════════════

// ADX — require trending market conditions
c_adx = not i_adxOn or adxVal >= i_adxMin

// VWAP band exhaustion — skip longs above +2SD, shorts below -2SD
c_vwapBand_L = not i_vwapBandFilt or close < vwapU2
c_vwapBand_S = not i_vwapBandFilt or close > vwapD2

// Candidate SL (computed before signal to enable min-risk check)
atrBuf      = atr * i_atrMult
candLongSL  = math.min(nz(lastBullSweepLow,  nearLow),  low)  - atrBuf
candShortSL = math.max(nz(lastBearSweepHigh, nearHigh), high) + atrBuf

// Minimum risk — SL must be ≥ i_minRisk×ATR from entry
c_minRisk_L = (close - candLongSL)  >= atr * i_minRisk
c_minRisk_S = (candShortSL - close) >= atr * i_minRisk

// POC proximity — skip if POC sits within 1×ATR in direction of travel
c_vp_L = not (i_vpOn and i_vpPOCFilt) or na(vpPOC) or vpPOC <= close or vpPOC > close + atr
c_vp_S = not (i_vpOn and i_vpPOCFilt) or na(vpPOC) or vpPOC >= close or vpPOC < close - atr

// ══════════════════════════════════════════════════════════════════════════════
// SIGNAL CONDITIONS
// ══════════════════════════════════════════════════════════════════════════════

// ── Long ──
c_ses_L     = inEntryWin
c_sweep_L   = recentBullSweep
c_trend_L   = trendDir >= 0 or emaBull
c_ema_L     = emaBull
c_vwap_L    = vwapBull
c_impulse_L = recentBullDisp or inBullFVG or recentBullFVG
c_vol_L     = volSpike or relVol > 1.0
c_rsi_L     = rsiBull
c_delta_L   = deltaPos or cvdUp
c_noise_L   = atrOk and volOk

buyCondition = c_ses_L and c_sweep_L and c_trend_L and c_ema_L and
     c_vwap_L and c_impulse_L and c_vol_L and c_rsi_L and
     c_delta_L and c_noise_L

// ── Short ──
c_ses_S     = inEntryWin
c_sweep_S   = recentBearSweep
c_trend_S   = trendDir <= 0 or emaBear
c_ema_S     = emaBear
c_vwap_S    = vwapBear
c_impulse_S = recentBearDisp or inBearFVG or recentBearFVG
c_vol_S     = volSpike or relVol > 1.0
c_rsi_S     = rsiBear
c_delta_S   = deltaNeg or cvdDown
c_noise_S   = atrOk and volOk

sellCondition = c_ses_S and c_sweep_S and c_trend_S and c_ema_S and
     c_vwap_S and c_impulse_S and c_vol_S and c_rsi_S and
     c_delta_S and c_noise_S

noPos      = strategy.position_size == 0
buySignal  = buyCondition  and noPos and c_adx and c_vwapBand_L and c_vp_L and c_minRisk_L
sellSignal = sellCondition and noPos and c_adx and c_vwapBand_S and c_vp_S and c_minRisk_S

// ══════════════════════════════════════════════════════════════════════════════
// STOP LOSS
// ══════════════════════════════════════════════════════════════════════════════

var float longSL  = na
var float shortSL = na

if buySignal
    longSL  := candLongSL

if sellSignal
    shortSL := candShortSL

// ══════════════════════════════════════════════════════════════════════════════
// TAKE PROFIT
// ══════════════════════════════════════════════════════════════════════════════

var float lTP1 = na
var float lTP2 = na
var float lTP3 = na
var float lRun = na
var float sTP1 = na
var float sTP2 = na
var float sTP3 = na
var float sRun = na

if buySignal and not na(longSL)
    float r = close - longSL
    lTP1 := close + r * i_tp1R
    lTP2 := close + r * i_tp2R
    lTP3 := close + r * i_tp3R
    lRun := close + r * i_runR

if sellSignal and not na(shortSL)
    float r = shortSL - close
    sTP1 := close - r * i_tp1R
    sTP2 := close - r * i_tp2R
    sTP3 := close - r * i_tp3R
    sRun := close - r * i_runR

// ══════════════════════════════════════════════════════════════════════════════
// PROGRESSIVE STOP MANAGEMENT
// Breakeven after TP1 tags. 2×ATR trail after TP2 tags.
// longSL / shortSL are var-persisted so every bar's strategy.exit picks up
// the updated value automatically.
// ══════════════════════════════════════════════════════════════════════════════

var float longEntry  = na
var float shortEntry = na
var bool  longBE     = false
var bool  shortBE    = false
var bool  longTA     = false
var bool  shortTA    = false

if buySignal
    longEntry := close
    longBE    := false
    longTA    := false

if sellSignal
    shortEntry := close
    shortBE    := false
    shortTA    := false

if strategy.position_size > 0 and not longBE and not na(lTP1) and high >= lTP1
    longSL := math.max(longSL, longEntry)
    longBE := true

if strategy.position_size < 0 and not shortBE and not na(sTP1) and low <= sTP1
    shortSL := math.min(shortSL, shortEntry)
    shortBE  := true

atrTrail = atr * 2.0

if strategy.position_size > 0 and not longTA and not na(lTP2) and high >= lTP2
    longTA := true

if strategy.position_size < 0 and not shortTA and not na(sTP2) and low <= sTP2
    shortTA := true

if strategy.position_size > 0 and longTA
    longSL := math.max(longSL, close - atrTrail)

if strategy.position_size < 0 and shortTA
    shortSL := math.min(shortSL, close + atrTrail)

// ══════════════════════════════════════════════════════════════════════════════
// STRATEGY EXECUTION
// ══════════════════════════════════════════════════════════════════════════════

if buySignal
    strategy.entry("Long",  strategy.long,  comment = "ISP Buy")

if sellSignal
    strategy.entry("Short", strategy.short, comment = "ISP Sell")

if strategy.position_size > 0 and not na(longSL)
    strategy.exit("L-TP1", "Long",  qty_percent = i_tp1pct, limit = lTP1, stop = longSL, comment = "TP1")
    strategy.exit("L-TP2", "Long",  qty_percent = i_tp2pct, limit = lTP2, stop = longSL, comment = "TP2")
    strategy.exit("L-TP3", "Long",  qty_percent = i_tp3pct, limit = lTP3, stop = longSL, comment = "TP3")
    strategy.exit("L-Run", "Long",  qty_percent = 100.0,    limit = lRun, stop = longSL, comment = "Runner")

if strategy.position_size < 0 and not na(shortSL)
    strategy.exit("S-TP1", "Short", qty_percent = i_tp1pct, limit = sTP1, stop = shortSL, comment = "TP1")
    strategy.exit("S-TP2", "Short", qty_percent = i_tp2pct, limit = sTP2, stop = shortSL, comment = "TP2")
    strategy.exit("S-TP3", "Short", qty_percent = i_tp3pct, limit = sTP3, stop = shortSL, comment = "TP3")
    strategy.exit("S-Run", "Short", qty_percent = 100.0,    limit = sRun, stop = shortSL, comment = "Runner")

// ══════════════════════════════════════════════════════════════════════════════
// VISUAL
// ══════════════════════════════════════════════════════════════════════════════

bgcolor(i_showSessBG and inSession ? color.new(color.blue, 93) : na, title = "Session BG")

plot(i_showEMAs  ? emaF     : na, "EMA Fast", color = color.new(color.yellow, 0), linewidth = 1)
plot(i_showEMAs  ? emaM     : na, "EMA Mid",  color = color.new(color.orange, 0), linewidth = 1)
plot(i_showEMAs  ? emaS     : na, "EMA Slow", color = color.new(color.red,    0), linewidth = 2)
plot(i_showVWAP  ? vwap_val : na, "VWAP",     color = color.new(color.purple, 0), linewidth = 2)

// ── VWAP bands ──
plot(i_showVWAPBands and inSession ? vwapU1 : na, "VWAP +1SD", color = color.new(color.purple, 65), linewidth = 1)
plot(i_showVWAPBands and inSession ? vwapU2 : na, "VWAP +2SD", color = color.new(color.purple, 40), linewidth = 1)
plot(i_showVWAPBands and inSession ? vwapD1 : na, "VWAP -1SD", color = color.new(color.purple, 65), linewidth = 1)
plot(i_showVWAPBands and inSession ? vwapD2 : na, "VWAP -2SD", color = color.new(color.purple, 40), linewidth = 1)

// ── Volume Profile ──
plot(i_showVP and i_vpOn and inSession ? vpPOC : na, "VP POC", color = color.new(color.yellow, 0),  linewidth = 2, style = plot.style_stepline)
plot(i_showVP and i_vpOn and inSession ? vpVAH : na, "VP VAH", color = color.new(color.gray,   30), linewidth = 1, style = plot.style_stepline)
plot(i_showVP and i_vpOn and inSession ? vpVAL : na, "VP VAL", color = color.new(color.gray,   30), linewidth = 1, style = plot.style_stepline)

// ── Session HL + Structure ──
plot(i_showSesHL and inSession ? sessionHigh : na, "Sess H", color = color.new(color.teal,   0), style = plot.style_stepline, linewidth = 1)
plot(i_showSesHL and inSession ? sessionLow  : na, "Sess L", color = color.new(color.maroon, 0), style = plot.style_stepline, linewidth = 1)
plot(i_showStr ? nearHigh : na, "Near High", color = color.new(color.silver, 50), style = plot.style_stepline, linewidth = 1)
plot(i_showStr ? nearLow  : na, "Near Low",  color = color.new(color.silver, 50), style = plot.style_stepline, linewidth = 1)

// ── BOS / CHoCH ──
plotshape(i_showBOS and bullBOS,   location = location.belowbar, style = shape.labelup,   color = color.new(color.lime,    0), text = "BOS",   textcolor = color.black, size = size.tiny)
plotshape(i_showBOS and bearBOS,   location = location.abovebar, style = shape.labeldown, color = color.new(color.red,     0), text = "BOS",   textcolor = color.white, size = size.tiny)
plotshape(i_showBOS and bullCHoCH, location = location.belowbar, style = shape.labelup,   color = color.new(color.aqua,    0), text = "CHoCH", textcolor = color.black, size = size.tiny)
plotshape(i_showBOS and bearCHoCH, location = location.abovebar, style = shape.labeldown, color = color.new(color.fuchsia, 0), text = "CHoCH", textcolor = color.white, size = size.tiny)

// ── Sweep dots ──
plotshape(bullSweep_bar, location = location.belowbar, style = shape.circle, color = color.new(color.lime, 30), size = size.tiny, title = "Bull Sweep")
plotshape(bearSweep_bar, location = location.abovebar, style = shape.circle, color = color.new(color.red,  30), size = size.tiny, title = "Bear Sweep")

// ── FVG zones (most recent bull/bear only — deleted on refresh to prevent line buildup) ──
var line bFVG_topLn = na
var line bFVG_botLn = na
var line vFVG_topLn = na
var line vFVG_botLn = na

if i_showFVG and i_fvgOn
    if bullFVG_bar
        line.delete(bFVG_topLn)
        line.delete(bFVG_botLn)
        bFVG_topLn := line.new(bar_index, low,     bar_index + 40, low,     color = color.new(color.green, 50), style = line.style_dashed, width = 1)
        bFVG_botLn := line.new(bar_index, high[2], bar_index + 40, high[2], color = color.new(color.green, 50), style = line.style_dashed, width = 1)
    if bearFVG_bar
        line.delete(vFVG_topLn)
        line.delete(vFVG_botLn)
        vFVG_topLn := line.new(bar_index, low[2], bar_index + 40, low[2], color = color.new(color.red, 50), style = line.style_dashed, width = 1)
        vFVG_botLn := line.new(bar_index, high,   bar_index + 40, high,   color = color.new(color.red, 50), style = line.style_dashed, width = 1)

// ── Entry signals ──
plotshape(buySignal,  location = location.belowbar, style = shape.triangleup,   color = color.new(color.lime, 0), size = size.normal, title = "Buy Signal")
plotshape(sellSignal, location = location.abovebar, style = shape.triangledown, color = color.new(color.red,  0), size = size.normal, title = "Sell Signal")

// ── SL / TP lines on entry bars ──
if i_showSLTP
    int ext = bar_index + 35

    if buySignal and not na(longSL)
        float riskL = close - longSL
        label.new(bar_index, low - atr * 0.7,
             "LONG @ " + fmtP(close) + "\nRisk " + fmtP(riskL) + " pts",
             color = color.new(color.lime, 10), textcolor = color.black,
             style = label.style_label_up, size = size.small, xloc = xloc.bar_index)
        drawLevel(bar_index, longSL, ext, color.new(color.red,   0), color.new(color.red,   10), color.white, "SL  " + fmtP(longSL))
        drawLevel(bar_index, lTP1,   ext, color.new(color.lime,  0), color.new(color.lime,  10), color.black, "TP1 " + fmtP(lTP1) + " (" + str.tostring(i_tp1R) + "R)")
        drawLevel(bar_index, lTP2,   ext, color.new(color.green, 0), color.new(color.green, 10), color.white, "TP2 " + fmtP(lTP2) + " (" + str.tostring(i_tp2R) + "R)")
        drawLevel(bar_index, lTP3,   ext, color.new(color.teal,  0), color.new(color.teal,  10), color.white, "TP3 " + fmtP(lTP3) + " (" + str.tostring(i_tp3R) + "R)")
        drawLevel(bar_index, lRun,   ext, color.new(color.aqua,  0), color.new(color.aqua,  10), color.black, "RUN " + fmtP(lRun)  + " (" + str.tostring(i_runR)  + "R)")

    if sellSignal and not na(shortSL)
        float riskS = shortSL - close
        label.new(bar_index, high + atr * 0.7,
             "SHORT @ " + fmtP(close) + "\nRisk " + fmtP(riskS) + " pts",
             color = color.new(color.red, 10), textcolor = color.white,
             style = label.style_label_down, size = size.small, xloc = xloc.bar_index)
        drawLevel(bar_index, shortSL, ext, color.new(color.red,   0), color.new(color.red,   10), color.white, "SL  " + fmtP(shortSL))
        drawLevel(bar_index, sTP1,    ext, color.new(color.lime,  0), color.new(color.lime,  10), color.black, "TP1 " + fmtP(sTP1) + " (" + str.tostring(i_tp1R) + "R)")
        drawLevel(bar_index, sTP2,    ext, color.new(color.green, 0), color.new(color.green, 10), color.white, "TP2 " + fmtP(sTP2) + " (" + str.tostring(i_tp2R) + "R)")
        drawLevel(bar_index, sTP3,    ext, color.new(color.teal,  0), color.new(color.teal,  10), color.white, "TP3 " + fmtP(sTP3) + " (" + str.tostring(i_tp3R) + "R)")
        drawLevel(bar_index, sRun,    ext, color.new(color.aqua,  0), color.new(color.aqua,  10), color.black, "RUN " + fmtP(sRun)  + " (" + str.tostring(i_runR)  + "R)")

// ══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

if i_showDash
    string td = trendDir == 1 ? "BULL" : trendDir == -1 ? "BEAR" : "NEUT"
    string sv = inEntryWin ? "ACTIVE" : inSession ? "WIND-DOWN" : "OFF"
    string vl = volSpike ? "SPIKE" : relVol > 1.0 ? "NORM" : "LOW"
    string vw = close > vwapU2   ? "ABOVE +2SD" :
                close > vwapU1   ? "ABOVE +1SD" :
                close > vwap_val ? "ABOVE"       :
                close > vwapD1   ? "BELOW"       :
                close > vwapD2   ? "BELOW -1SD"  : "BELOW -2SD"
    string em = emaBull ? "BULL" : "BEAR"
    string sw = recentBullSweep ? "BULL SWEEP" : recentBearSweep ? "BEAR SWEEP" : "none"
    string po = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    string dx = str.tostring(math.round(adxVal, 1)) + (adxVal >= i_adxMin ? " OK" : " LOW")
    string pc = not na(vpPOC) ? fmtP(vpPOC) : "n/a"

    int    tot = strategy.wintrades + strategy.losstrades
    string wr  = tot > 0 ? str.tostring(math.round(strategy.wintrades / tot * 100.0, 1)) + "%" : "N/A"
    string pf  = strategy.grossloss != 0.0 ? str.tostring(math.round(strategy.grossprofit / math.abs(strategy.grossloss), 2)) : "N/A"

    bool   activeBE = (strategy.position_size > 0 and longBE) or (strategy.position_size < 0 and shortBE)
    bool   activeTA = (strategy.position_size > 0 and longTA) or (strategy.position_size < 0 and shortTA)

    string dashText =
         "═══ ISP v1.5 ═══\n"                                              +
         "Session : " + sv                                            + "\n" +
         "Trend   : " + td                                            + "\n" +
         "EMA     : " + em                                            + "\n" +
         "VWAP    : " + vw                                            + "\n" +
         "ADX     : " + dx                                            + "\n" +
         "Volume  : " + vl + " (" + str.tostring(math.round(relVol, 2)) + "x)\n" +
         "RSI     : " + str.tostring(math.round(rsi, 1))             + "\n" +
         "Sweep   : " + sw                                            + "\n" +
         "VP POC  : " + pc                                            + "\n" +
         "────────────────\n"                                               +
         "Position: " + po                                            + "\n" +
         "Breakevn: " + (activeBE ? "YES" : "NO")                    + "\n" +
         "Trail   : " + (activeTA ? "YES" : "NO")                    + "\n" +
         "Win Rate: " + wr                                            + "\n" +
         "Prof Fac: " + pf                                            + "\n" +
         "Net PnL : $" + str.tostring(math.round(strategy.netprofit, 2))

    var table dash = table.new(position.top_right, 1, 1,
         bgcolor      = color.new(color.black, 10),
         border_color = color.new(color.gray,  30),
         border_width = 1,
         frame_color  = color.new(color.gray,  20),
         frame_width  = 1)

    table.cell(dash, 0, 0, dashText,
         text_color = color.white,
         text_size  = size.small,
         bgcolor    = color.new(color.black, 15))

// ══════════════════════════════════════════════════════════════════════════════
// CONDITION DEBUG TABLE
// ══════════════════════════════════════════════════════════════════════════════

if i_showDebug
    string dbg =
         "── LONG ──\n"                                                                                           +
         fmtOk(c_ses_L)      + " Session/entry win\n"                                                            +
         fmtOk(c_sweep_L)    + " Bull sweep (" + str.tostring(ta.barssince(bullSweep_bar)) + "b ago)\n"          +
         fmtOk(c_trend_L)    + " Trend dir=" + str.tostring(trendDir)                                  + "\n"    +
         fmtOk(c_ema_L)      + " EMA fast > mid\n"                                                               +
         fmtOk(c_vwap_L)     + " Above VWAP\n"                                                                   +
         fmtOk(c_impulse_L)  + " Disp or FVG\n"                                                                  +
         fmtOk(c_vol_L)      + " Vol " + str.tostring(math.round(relVol, 2))                           + "x\n"   +
         fmtOk(c_rsi_L)      + " RSI " + str.tostring(math.round(rsi, 1))                              + "\n"    +
         fmtOk(c_delta_L)    + " Delta pos\n"                                                                     +
         fmtOk(c_noise_L)    + " Range/vol OK\n"                                                                  +
         fmtOk(c_adx)        + " ADX " + str.tostring(math.round(adxVal, 1))                           + "\n"    +
         fmtOk(c_vwapBand_L) + " VWAP band OK\n"                                                                 +
         fmtOk(c_vp_L)       + " VP POC OK\n"                                                                    +
         fmtOk(c_minRisk_L)  + " Min risk OK\n"                                                                   +
         "── SHORT ──\n"                                                                                          +
         fmtOk(c_ses_S)      + " Session/entry win\n"                                                            +
         fmtOk(c_sweep_S)    + " Bear sweep (" + str.tostring(ta.barssince(bearSweep_bar)) + "b ago)\n"          +
         fmtOk(c_trend_S)    + " Trend\n"                                                                        +
         fmtOk(c_ema_S)      + " EMA fast < mid\n"                                                               +
         fmtOk(c_vwap_S)     + " Below VWAP\n"                                                                   +
         fmtOk(c_impulse_S)  + " Disp or FVG\n"                                                                  +
         fmtOk(c_vol_S)      + " Volume\n"                                                                       +
         fmtOk(c_rsi_S)      + " RSI\n"                                                                          +
         fmtOk(c_delta_S)    + " Delta neg\n"                                                                     +
         fmtOk(c_noise_S)    + " Range/vol OK\n"                                                                  +
         fmtOk(c_adx)        + " ADX\n"                                                                          +
         fmtOk(c_vwapBand_S) + " VWAP band OK\n"                                                                 +
         fmtOk(c_vp_S)       + " VP POC OK\n"                                                                    +
         fmtOk(c_minRisk_S)  + " Min risk OK"

    var table tbl = table.new(position.bottom_left, 1, 1,
         bgcolor      = color.new(color.black, 10),
         border_color = color.new(color.gray,  30),
         border_width = 1)

    table.cell(tbl, 0, 0, dbg,
         text_color = color.white,
         text_size  = size.tiny,
         bgcolor    = color.new(color.black, 15))

// ══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(buySignal,     title = "ISP Buy Signal",  message = "ISP Buy | {{ticker}} @ {{close}} | {{time}}")
alertcondition(sellSignal,    title = "ISP Sell Signal", message = "ISP Sell | {{ticker}} @ {{close}} | {{time}}")
alertcondition(bullSweep_bar, title = "ISP Bull Sweep",  message = "Bull sweep | {{ticker}} @ {{close}}")
alertcondition(bearSweep_bar, title = "ISP Bear Sweep",  message = "Bear sweep | {{ticker}} @ {{close}}")
alertcondition(bullBOS,       title = "ISP Bull BOS",    message = "Bullish BOS | {{ticker}} @ {{close}}")
alertcondition(bearBOS,       title = "ISP Bear BOS",    message = "Bearish BOS | {{ticker}} @ {{close}}")
alertcondition(trendDir ==  1 and trendDir[1] !=  1, title = "ISP Trend Bull", message = "Trend → BULL | {{ticker}}")
alertcondition(trendDir == -1 and trendDir[1] != -1, title = "ISP Trend Bear", message = "Trend → BEAR | {{ticker}}")
