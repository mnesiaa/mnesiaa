// ============================================================
// INSTITUTIONAL SCALPER PRO v1.1
// Pine Script v6 — Strategy + Indicator Combined
// Author: Institutional Scalper Pro
// Optimized for: NQ, ES, SPY, QQQ, BTC, XAUUSD
// Timeframes: 1m, 3m, 5m
// ============================================================
// ARCHITECTURE
//   1. Market Structure (BOS/CHoCH/HH-LL)
//   2. Liquidity Concepts (sweeps, equal H/L, session H/L)
//   3. Smart Money / Order Flow (FVG, displacement, imbalance)
//   4. Volume Analysis (relative volume, absorption, CVD proxy)
//   5. Trend & Momentum Filters (VWAP, EMA 9/20/50, ATR, RSI)
//   6. Session Filter (NY AM 09:30–11:30 EST)
//   7. Signal Logic — sweep TRIGGERS, confirmation ENTRY (2-phase)
//   8. Stop Loss (structure-based + ATR buffer)
//   9. Take Profit (TP1/TP2/TP3/Runner, R-multiples)
//  10. Backtest Engine (strategy.entry / strategy.exit)
//  11. Visual Dashboard + Condition Debug
//  12. Alert Conditions
// ============================================================

//@version=6
strategy(
     title            = "Institutional Scalper Pro v1.1",
     shorttitle       = "ISP v1.1",
     overlay          = true,
     pyramiding       = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value= 10,
     initial_capital  = 100000,
     commission_type  = strategy.commission.percent,
     commission_value = 0.02,
     slippage         = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true
     )

// ─────────────────────────────────────────────
// ░░  INPUTS
// ─────────────────────────────────────────────

var string GRP_SESSION = "Session Filter"
i_useSession   = input.bool(true,  "Enable NY AM Session Filter", group=GRP_SESSION)
i_showSession  = input.bool(true,  "Shade Session Background",    group=GRP_SESSION)
i_sesStart     = input.int(930,    "Session Start (HHMM)",        group=GRP_SESSION)
i_sesEnd       = input.int(1130,   "Session End   (HHMM)",        group=GRP_SESSION)

var string GRP_MS = "Market Structure"
i_swingLen     = input.int(10, "Swing Lookback (bars)", minval=3, maxval=50, group=GRP_MS)
i_sweepWindow  = input.int(5,  "Sweep Confirmation Window (bars)", minval=1, maxval=15, group=GRP_MS)

var string GRP_FVG = "Fair Value Gap"
i_fvgEnable    = input.bool(true,  "Enable FVG Detection",        group=GRP_FVG)
i_fvgMinATR    = input.float(0.25, "Min FVG Size (ATR mult)",     minval=0.05, step=0.05, group=GRP_FVG)
i_fvgWindow    = input.int(5,      "FVG Entry Window (bars)",     minval=1, maxval=20,  group=GRP_FVG)

var string GRP_VOL = "Volume"
i_volLen       = input.int(20,   "Relative Volume Length",        minval=5,  group=GRP_VOL)
i_volThresh    = input.float(1.3,"Volume Spike Threshold",        minval=1.0,step=0.1, group=GRP_VOL)

var string GRP_TREND = "Trend & Momentum Filters"
i_ema9         = input.int(9,   "EMA Fast",   minval=3,  group=GRP_TREND)
i_ema20        = input.int(20,  "EMA Mid",    minval=5,  group=GRP_TREND)
i_ema50        = input.int(50,  "EMA Slow",   minval=20, group=GRP_TREND)
i_rsiLen       = input.int(14,  "RSI Length", minval=2,  group=GRP_TREND)
i_rsiBullMin   = input.int(45,  "RSI Min for Longs  (>)",  minval=30, maxval=65, group=GRP_TREND)
i_rsiBearMax   = input.int(55,  "RSI Max for Shorts (<)",  minval=35, maxval=70, group=GRP_TREND)
i_atrLen       = input.int(14,  "ATR Length",              minval=2,  group=GRP_TREND)
i_atrMult      = input.float(0.5,"ATR Stop Buffer Mult",   minval=0.1,step=0.1, group=GRP_TREND)
i_displLen     = input.int(5,   "Displacement Lookback (bars)", minval=1, maxval=10, group=GRP_TREND)

var string GRP_TP = "Take Profit (R-Multiples)"
i_tp1R         = input.float(1.0, "TP1 (R)",    minval=0.5, step=0.25, group=GRP_TP)
i_tp2R         = input.float(2.0, "TP2 (R)",    minval=1.0, step=0.25, group=GRP_TP)
i_tp3R         = input.float(3.0, "TP3 (R)",    minval=1.5, step=0.25, group=GRP_TP)
i_runR         = input.float(5.0, "Runner (R)", minval=2.0, step=0.5,  group=GRP_TP)
i_tp1pct       = input.float(40.0,"% Closed at TP1", minval=10, maxval=80, step=5, group=GRP_TP)
i_tp2pct       = input.float(30.0,"% Closed at TP2", minval=10, maxval=60, step=5, group=GRP_TP)
i_tp3pct       = input.float(20.0,"% Closed at TP3", minval=5,  maxval=40, step=5, group=GRP_TP)

var string GRP_VIZ = "Visual Settings"
i_showEMAs     = input.bool(true,  "Show EMAs",             group=GRP_VIZ)
i_showVWAP     = input.bool(true,  "Show VWAP",             group=GRP_VIZ)
i_showFVG      = input.bool(true,  "Show Fair Value Gaps",  group=GRP_VIZ)
i_showSesHL    = input.bool(true,  "Show Session High/Low", group=GRP_VIZ)
i_showBOS      = input.bool(true,  "Show BOS/CHoCH Labels", group=GRP_VIZ)
i_showDash     = input.bool(true,  "Show Dashboard",        group=GRP_VIZ)
i_showDebug    = input.bool(false, "Show Condition Debug",  group=GRP_VIZ)
i_showSLTP     = input.bool(true,  "Show SL/TP Lines",      group=GRP_VIZ)

// ─────────────────────────────────────────────
// ░░  CORE INDICATORS
// ─────────────────────────────────────────────

atr    = ta.atr(i_atrLen)
ema9   = ta.ema(close, i_ema9)
ema20  = ta.ema(close, i_ema20)
ema50  = ta.ema(close, i_ema50)
rsi    = ta.rsi(close, i_rsiLen)
[vwap_val, _, _] = ta.vwap(hlc3, true, 1)

avgVol  = ta.sma(volume, i_volLen)
relVol  = volume / avgVol
volSpike = relVol >= i_volThresh

// ─────────────────────────────────────────────
// ░░  SESSION LOGIC
// ─────────────────────────────────────────────
// Integer HHMM comparison is cleaner and avoids input.session quirks.

barHHMM = (hour(time, "America/New_York") * 100) + minute(time, "America/New_York")
rawInSession = barHHMM >= i_sesStart and barHHMM < i_sesEnd
inSession = not i_useSession or rawInSession

var bool  prevInSession = false
var float sessionHigh   = na
var float sessionLow    = na
sessionOpened = inSession and not prevInSession
prevInSession := inSession

if sessionOpened
    sessionHigh := high
    sessionLow  := low
else if inSession
    sessionHigh := math.max(sessionHigh, high)
    sessionLow  := math.min(sessionLow,  low)

// ─────────────────────────────────────────────
// ░░  SWING HIGH / LOW  (confirmed, non-repainting)
// ─────────────────────────────────────────────

swingHigh = ta.pivothigh(high, i_swingLen, i_swingLen)
swingLow  = ta.pivotlow (low,  i_swingLen, i_swingLen)

var float lastSwingHigh  = na, var float lastSwingHigh2 = na
var float lastSwingLow   = na, var float lastSwingLow2  = na

if not na(swingHigh)
    lastSwingHigh2 := lastSwingHigh
    lastSwingHigh  := swingHigh

if not na(swingLow)
    lastSwingLow2 := lastSwingLow
    lastSwingLow  := swingLow

// ─────────────────────────────────────────────
// ░░  MARKET STRUCTURE — BOS / CHoCH
// ─────────────────────────────────────────────

var int   trendDir    = 0
var bool  bullBOS     = false, var bool bearBOS     = false
var bool  bullCHoCH   = false, var bool bearCHoCH   = false

bullBOS   := false ; bearBOS   := false
bullCHoCH := false ; bearCHoCH := false

if not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
    if trendDir >= 0
        bullBOS   := true
    else
        bullCHoCH := true
    trendDir := 1

if not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
    if trendDir <= 0
        bearBOS   := true
    else
        bearCHoCH := true
    trendDir := -1

// ─────────────────────────────────────────────
// ░░  LIQUIDITY SWEEP  (per-bar detection)
// ─────────────────────────────────────────────
// Sweep = wick pierces prior swing but CLOSES back on the origin side.

bullSweep_bar = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow
bearSweep_bar = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

// Persist the sweep-low/high price for SL reference
var float lastBullSweepLow  = na
var float lastBearSweepHigh = na

if bullSweep_bar
    lastBullSweepLow  := low
if bearSweep_bar
    lastBearSweepHigh := high

// Sweep within window → entry confirmation still valid
recentBullSweep = ta.barssince(bullSweep_bar) <= i_sweepWindow
recentBearSweep = ta.barssince(bearSweep_bar) <= i_sweepWindow

// ─────────────────────────────────────────────
// ░░  FAIR VALUE GAP  (3-candle imbalance)
// ─────────────────────────────────────────────

minFVGSize  = atr * i_fvgMinATR
bullFVG_bar = low    > high[2] and (low - high[2]) >= minFVGSize
bearFVG_bar = high   < low[2]  and (low[2] - high) >= minFVGSize

var float bFVG_top = na, var float bFVG_bot = na, var bool bFVG_active = false
var float vFVG_top = na, var float vFVG_bot = na, var bool vFVG_active = false

if i_fvgEnable and bullFVG_bar
    bFVG_top := low  ; bFVG_bot := high[2] ; bFVG_active := true
if i_fvgEnable and bearFVG_bar
    vFVG_top := low[2] ; vFVG_bot := high  ; vFVG_active := true

if bFVG_active and close < bFVG_bot
    bFVG_active := false
if vFVG_active and close > vFVG_top
    vFVG_active := false

priceInBullFVG = bFVG_active and close >= bFVG_bot and close <= bFVG_top
priceInBearFVG = vFVG_active and close >= vFVG_bot and close <= vFVG_top
recentBullFVG  = ta.barssince(bullFVG_bar) <= i_fvgWindow
recentBearFVG  = ta.barssince(bearFVG_bar) <= i_fvgWindow

// ─────────────────────────────────────────────
// ░░  DISPLACEMENT CANDLE
// ─────────────────────────────────────────────
// Large-body candle (> 1.5× ATR) closing in top/bottom 25% of range.

bodySize      = math.abs(close - open)
range_        = high - low
bullDisplace_bar = bodySize > atr * 1.5 and close > open and close >= low  + range_ * 0.75
bearDisplace_bar = bodySize > atr * 1.5 and close < open and close <= high - range_ * 0.75

recentBullDisplace = ta.barssince(bullDisplace_bar) <= i_displLen
recentBearDisplace = ta.barssince(bearDisplace_bar) <= i_displLen

// ─────────────────────────────────────────────
// ░░  CVD  (cumulative delta proxy)
// ─────────────────────────────────────────────

buyVolEst = volume * ((close - low)  / math.max(high - low, 1e-10))
sellVolEst = volume * ((high - close) / math.max(high - low, 1e-10))
delta = buyVolEst - sellVolEst

var float cvd = 0.0
cvd := cvd[1] + delta

cvdRising  = cvd > cvd[5]   // short window — more responsive
cvdFalling = cvd < cvd[5]
deltaPositive = delta > 0   // current bar buy pressure
deltaNegative = delta < 0

// ─────────────────────────────────────────────
// ░░  TREND FILTERS
// ─────────────────────────────────────────────

emaBull = ema9 > ema20
emaBear = ema9 < ema20
emaBullStrong = ema9 > ema20 and ema20 > ema50
emaBearStrong = ema9 < ema20 and ema20 < ema50

vwapBull = close > vwap_val
vwapBear = close < vwap_val

// VWAP reclaim: price crossed above/below VWAP within recent bars
vwapBullReclaim = ta.crossover(close,  vwap_val) or (vwapBull and ta.barssince(ta.crossover(close, vwap_val)) <= 3)
vwapBearReclaim = ta.crossunder(close, vwap_val) or (vwapBear and ta.barssince(ta.crossunder(close, vwap_val)) <= 3)

atrNorm       = atr / close * 100
minVolatility = atrNorm > 0.02   // > 2 bps ATR (very permissive lower bound)

// RSI: directional bias with turning confirmation
rsiLongOk  = rsi > i_rsiBullMin and rsi > rsi[2]    // above floor AND rising
rsiShortOk = rsi < i_rsiBearMax and rsi < rsi[2]    // below ceiling AND falling

// ─────────────────────────────────────────────
// ░░  CHOP / FAKEOUT FILTER  (simplified)
// ─────────────────────────────────────────────
// Only block truly dead markets — don't over-filter sweep setups.

choppyRange = (high - low) < atr * 0.4
lowVolume   = volume < avgVol * 0.7
chopFilter  = choppyRange or lowVolume

// ─────────────────────────────────────────────
// ░░  TWO-PHASE SIGNAL LOGIC
// ─────────────────────────────────────────────
//
// PHASE 1 (Trigger): A liquidity sweep occurs. We record it.
// PHASE 2 (Entry):   Within `sweepWindow` bars, ALL confirmations align.
//                    THIS is the signal bar printed on chart.
//
// For longs: sweep fires when price wicks below a swing low and closes back.
//            Entry triggers on a LATER bar (or same bar) when price confirms.
//
// This separates the "stop hunt" event from the "institutional entry" bar.
// ─────────────────────────────────────────────

// ── BUY conditions ────────────────────────────────────────────────────────
// Gate 1: In session
// Gate 2: Recent sweep (within sweepWindow bars)
// Gate 3: Bullish trend or neutral (not confirmed bear trend)
// Gate 4: EMA short-term alignment
// Gate 5: Price at or above VWAP
// Gate 6: Displacement OR FVG formed recently
// Gate 7: Volume above average
// Gate 8: RSI above floor AND turning up
// Gate 9: CVD/delta favors buyers
// Gate 10: Not in chop
// Gate 11: Minimum volatility present

cond_ses_L     = inSession
cond_sweep_L   = recentBullSweep
cond_struct_L  = trendDir >= 0 or emaBull          // not confirmed bear; EMA acts as fallback
cond_ema_L     = emaBull                            // ema9 > ema20
cond_vwap_L    = vwapBull                           // close above VWAP
cond_impulse_L = recentBullDisplace or priceInBullFVG or recentBullFVG
cond_vol_L     = volSpike or relVol > 1.0           // softer: above-avg vol ok
cond_rsi_L     = rsiLongOk
cond_cvd_L     = cvdRising or deltaPositive         // cumulative OR current bar
cond_chop_L    = not chopFilter
cond_atr_L     = minVolatility

buyCondition = cond_ses_L and cond_sweep_L and cond_struct_L
     and cond_ema_L and cond_vwap_L and cond_impulse_L
     and cond_vol_L and cond_rsi_L  and cond_cvd_L
     and cond_chop_L and cond_atr_L

// ── SELL conditions ───────────────────────────────────────────────────────

cond_ses_S     = inSession
cond_sweep_S   = recentBearSweep
cond_struct_S  = trendDir <= 0 or emaBear
cond_ema_S     = emaBear
cond_vwap_S    = vwapBear
cond_impulse_S = recentBearDisplace or priceInBearFVG or recentBearFVG
cond_vol_S     = volSpike or relVol > 1.0
cond_rsi_S     = rsiShortOk
cond_cvd_S     = cvdFalling or deltaNegative
cond_chop_S    = not chopFilter
cond_atr_S     = minVolatility

sellCondition = cond_ses_S and cond_sweep_S and cond_struct_S
     and cond_ema_S and cond_vwap_S and cond_impulse_S
     and cond_vol_S and cond_rsi_S  and cond_cvd_S
     and cond_chop_S and cond_atr_S

noActiveTrade = strategy.position_size == 0

buySignal  = buyCondition  and noActiveTrade
sellSignal = sellCondition and noActiveTrade

// ─────────────────────────────────────────────
// ░░  STOP LOSS
// ─────────────────────────────────────────────

atrBuffer = atr * i_atrMult

var float longSL  = na
var float shortSL = na

if buySignal
    // SL below the lowest point of the sweep wick
    float sweepLow = na(lastBullSweepLow) ? lastSwingLow : math.min(lastBullSweepLow, lastSwingLow)
    longSL := sweepLow - atrBuffer

if sellSignal
    float sweepHigh = na(lastBearSweepHigh) ? lastSwingHigh : math.max(lastBearSweepHigh, lastSwingHigh)
    shortSL := sweepHigh + atrBuffer

// ─────────────────────────────────────────────
// ░░  TAKE PROFIT  (R-multiples)
// ─────────────────────────────────────────────

var float longTP1 = na, var float longTP2  = na
var float longTP3 = na, var float longRun  = na
var float shortTP1= na, var float shortTP2 = na
var float shortTP3= na, var float shortRun = na

if buySignal and not na(longSL)
    riskL    = close - longSL
    longTP1 := close + riskL * i_tp1R
    longTP2 := close + riskL * i_tp2R
    longTP3 := close + riskL * i_tp3R
    longRun := close + riskL * i_runR

if sellSignal and not na(shortSL)
    riskS     = shortSL - close
    shortTP1 := close - riskS * i_tp1R
    shortTP2 := close - riskS * i_tp2R
    shortTP3 := close - riskS * i_tp3R
    shortRun := close - riskS * i_runR

// ─────────────────────────────────────────────
// ░░  STRATEGY EXECUTION
// ─────────────────────────────────────────────

if buySignal
    strategy.entry("Long", strategy.long, comment="ISP Buy")

if sellSignal
    strategy.entry("Short", strategy.short, comment="ISP Sell")

if strategy.position_size > 0 and not na(longSL)
    strategy.exit("L-TP1", "Long", qty_percent=i_tp1pct, limit=longTP1, stop=longSL, comment="TP1")
    strategy.exit("L-TP2", "Long", qty_percent=i_tp2pct, limit=longTP2, stop=longSL, comment="TP2")
    strategy.exit("L-TP3", "Long", qty_percent=i_tp3pct, limit=longTP3, stop=longSL, comment="TP3")
    strategy.exit("L-Run", "Long", qty_percent=100,       limit=longRun,  stop=longSL, comment="Runner")

if strategy.position_size < 0 and not na(shortSL)
    strategy.exit("S-TP1", "Short", qty_percent=i_tp1pct, limit=shortTP1, stop=shortSL, comment="TP1")
    strategy.exit("S-TP2", "Short", qty_percent=i_tp2pct, limit=shortTP2, stop=shortSL, comment="TP2")
    strategy.exit("S-TP3", "Short", qty_percent=i_tp3pct, limit=shortTP3, stop=shortSL, comment="TP3")
    strategy.exit("S-Run", "Short", qty_percent=100,       limit=shortRun,  stop=shortSL, comment="Runner")

// ─────────────────────────────────────────────
// ░░  VISUAL LAYER
// ─────────────────────────────────────────────

bgcolor(i_showSession and inSession ? color.new(color.blue, 93) : na, title="Session BG")

plot(i_showEMAs ? ema9  : na, "EMA 9",  color=color.new(color.yellow, 0), linewidth=1)
plot(i_showEMAs ? ema20 : na, "EMA 20", color=color.new(color.orange, 0), linewidth=1)
plot(i_showEMAs ? ema50 : na, "EMA 50", color=color.new(color.red,    0), linewidth=2)
plot(i_showVWAP ? vwap_val : na, "VWAP", color=color.new(color.purple, 0), linewidth=2)

plot(i_showSesHL and inSession ? sessionHigh : na, "Sess High", color=color.new(color.teal,   0), style=plot.style_stepline, linewidth=1)
plot(i_showSesHL and inSession ? sessionLow  : na, "Sess Low",  color=color.new(color.maroon, 0), style=plot.style_stepline, linewidth=1)

// BOS / CHoCH labels
plotshape(i_showBOS and bullBOS,   style=shape.labelup,   location=location.belowbar, color=color.new(color.lime,    0), text="BOS",   textcolor=color.black, size=size.tiny, title="Bull BOS")
plotshape(i_showBOS and bearBOS,   style=shape.labeldown, location=location.abovebar, color=color.new(color.red,     0), text="BOS",   textcolor=color.white, size=size.tiny, title="Bear BOS")
plotshape(i_showBOS and bullCHoCH, style=shape.labelup,   location=location.belowbar, color=color.new(color.aqua,    0), text="CHoCH", textcolor=color.black, size=size.tiny, title="Bull CHoCH")
plotshape(i_showBOS and bearCHoCH, style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia, 0), text="CHoCH", textcolor=color.white, size=size.tiny, title="Bear CHoCH")

// Sweep dots
plotshape(bullSweep_bar, style=shape.circle, location=location.belowbar, color=color.new(color.lime, 30),  size=size.tiny, title="Bull Sweep")
plotshape(bearSweep_bar, style=shape.circle, location=location.abovebar, color=color.new(color.red,  30),  size=size.tiny, title="Bear Sweep")

// FVG zone lines
if i_showFVG and i_fvgEnable
    if bullFVG_bar
        line.new(bar_index, low,     bar_index + 20, low,     color=color.new(color.green, 50), style=line.style_dashed, width=1)
        line.new(bar_index, high[2], bar_index + 20, high[2], color=color.new(color.green, 50), style=line.style_dashed, width=1)
    if bearFVG_bar
        line.new(bar_index, low[2],  bar_index + 20, low[2],  color=color.new(color.red,   50), style=line.style_dashed, width=1)
        line.new(bar_index, high,    bar_index + 20, high,    color=color.new(color.red,   50), style=line.style_dashed, width=1)

// Entry arrows
plotshape(buySignal,  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.normal, title="Buy Signal")
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.new(color.red,  0), size=size.normal, title="Sell Signal")

// SL / TP dashed lines on signal bar
if i_showSLTP
    if buySignal and not na(longSL)
        line.new(bar_index, longSL,  bar_index + 30, longSL,  color=color.new(color.red,   20), style=line.style_dashed, width=1)
        line.new(bar_index, longTP1, bar_index + 30, longTP1, color=color.new(color.lime,  20), style=line.style_dashed, width=1)
        line.new(bar_index, longTP2, bar_index + 30, longTP2, color=color.new(color.green, 20), style=line.style_dashed, width=1)
        line.new(bar_index, longTP3, bar_index + 30, longTP3, color=color.new(color.teal,  20), style=line.style_dashed, width=1)
        line.new(bar_index, longRun, bar_index + 30, longRun, color=color.new(color.aqua,  20), style=line.style_dashed, width=1)
    if sellSignal and not na(shortSL)
        line.new(bar_index, shortSL,  bar_index + 30, shortSL,  color=color.new(color.red,   20), style=line.style_dashed, width=1)
        line.new(bar_index, shortTP1, bar_index + 30, shortTP1, color=color.new(color.lime,  20), style=line.style_dashed, width=1)
        line.new(bar_index, shortTP2, bar_index + 30, shortTP2, color=color.new(color.green, 20), style=line.style_dashed, width=1)
        line.new(bar_index, shortTP3, bar_index + 30, shortTP3, color=color.new(color.teal,  20), style=line.style_dashed, width=1)
        line.new(bar_index, shortRun, bar_index + 30, shortRun, color=color.new(color.aqua,  20), style=line.style_dashed, width=1)

// ─────────────────────────────────────────────
// ░░  DASHBOARD
// ─────────────────────────────────────────────

if i_showDash
    string trendStr = trendDir == 1 ? "▲ BULL" : trendDir == -1 ? "▼ BEAR" : "── NEUT"
    string sessStr  = inSession     ? "✔ ACTIVE" : "✖ OFF"
    string volStr   = volSpike      ? "SPIKE" : relVol > 1.0 ? "NORM" : "LOW"
    string vwapStr  = vwapBull      ? "ABOVE" : "BELOW"
    string rsiStr   = str.tostring(math.round(rsi, 1))
    string emaStr   = emaBullStrong ? "▲▲ STRONG" : emaBull ? "▲ BULL" : emaBearStrong ? "▼▼ STRONG" : emaBear ? "▼ BEAR" : "MIXED"
    string sweepStr = recentBullSweep ? "BULL SWEEP" : recentBearSweep ? "BEAR SWEEP" : "─"
    string posStr   = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    string winStr   = (strategy.wintrades + strategy.losstrades) > 0
         ? str.tostring(math.round(strategy.wintrades / (strategy.wintrades + strategy.losstrades) * 100, 1)) + "%"
         : "N/A"
    string pfStr    = strategy.grossloss != 0
         ? str.tostring(math.round(strategy.grossprofit / math.abs(strategy.grossloss), 2))
         : "N/A"

    dashText = "═══ ISP v1.1 ═══\n"
         + "Session : " + sessStr  + "\n"
         + "Trend   : " + trendStr + "\n"
         + "EMA     : " + emaStr   + "\n"
         + "VWAP    : " + vwapStr  + "\n"
         + "Volume  : " + volStr   + " (" + str.tostring(math.round(relVol, 2)) + "x)\n"
         + "RSI     : " + rsiStr   + "\n"
         + "Sweep   : " + sweepStr + "\n"
         + "────────────────\n"
         + "Position: " + posStr   + "\n"
         + "Win Rate: " + winStr   + "\n"
         + "Prof Fac: " + pfStr    + "\n"
         + "Net P&L : $" + str.tostring(math.round(strategy.netprofit, 2))

    var table dash = table.new(position.top_right, 1, 1,
         bgcolor=color.new(color.black, 10),
         border_color=color.new(color.gray, 30), border_width=1,
         frame_color=color.new(color.gray, 20),  frame_width=1)
    table.cell(dash, 0, 0, dashText,
         text_color=color.new(color.white, 0),
         text_size=size.small,
         bgcolor=color.new(color.black, 15))

// ─────────────────────────────────────────────
// ░░  CONDITION DEBUG TABLE  (toggle on to diagnose why no signal)
// ─────────────────────────────────────────────

if i_showDebug
    bool  isL = true   // show long-side debug

    ok(bool b) => b ? "✔" : "✗"

    dbgText = "── LONG CONDITION DEBUG ──\n"
         + ok(cond_ses_L)     + " Session active\n"
         + ok(cond_sweep_L)   + " Recent bull sweep (" + str.tostring(ta.barssince(bullSweep_bar)) + " bars)\n"
         + ok(cond_struct_L)  + " Structure (trendDir=" + str.tostring(trendDir) + ")\n"
         + ok(cond_ema_L)     + " EMA9 > EMA20\n"
         + ok(cond_vwap_L)    + " Above VWAP\n"
         + ok(cond_impulse_L) + " Displacement / FVG\n"
         + ok(cond_vol_L)     + " Volume (" + str.tostring(math.round(relVol, 2)) + "x)\n"
         + ok(cond_rsi_L)     + " RSI (" + str.tostring(math.round(rsi, 1)) + " > " + str.tostring(i_rsiBullMin) + " & rising)\n"
         + ok(cond_cvd_L)     + " CVD/Delta positive\n"
         + ok(cond_chop_L)    + " No chop\n"
         + ok(cond_atr_L)     + " Volatility OK\n"
         + "── SHORT CONDITION DEBUG ──\n"
         + ok(cond_ses_S)     + " Session active\n"
         + ok(cond_sweep_S)   + " Recent bear sweep (" + str.tostring(ta.barssince(bearSweep_bar)) + " bars)\n"
         + ok(cond_struct_S)  + " Structure\n"
         + ok(cond_ema_S)     + " EMA9 < EMA20\n"
         + ok(cond_vwap_S)    + " Below VWAP\n"
         + ok(cond_impulse_S) + " Displacement / FVG\n"
         + ok(cond_vol_S)     + " Volume\n"
         + ok(cond_rsi_S)     + " RSI (" + str.tostring(math.round(rsi, 1)) + " < " + str.tostring(i_rsiBearMax) + " & falling)\n"
         + ok(cond_cvd_S)     + " CVD/Delta negative\n"
         + ok(cond_chop_S)    + " No chop\n"
         + ok(cond_atr_S)     + " Volatility OK"

    var table dbg = table.new(position.bottom_left, 1, 1,
         bgcolor=color.new(color.black, 10),
         border_color=color.new(color.gray, 30), border_width=1)
    table.cell(dbg, 0, 0, dbgText,
         text_color=color.new(color.white, 0),
         text_size=size.tiny,
         bgcolor=color.new(color.black, 15))

// ─────────────────────────────────────────────
// ░░  ALERTS
// ─────────────────────────────────────────────

alertcondition(buySignal,      title="ISP — Buy Signal",        message="ISP Buy | {{ticker}} @ {{close}} | {{time}}")
alertcondition(sellSignal,     title="ISP — Sell Signal",       message="ISP Sell | {{ticker}} @ {{close}} | {{time}}")
alertcondition(bullSweep_bar,  title="ISP — Bull Sweep",        message="Bullish liquidity sweep | {{ticker}} @ {{close}}")
alertcondition(bearSweep_bar,  title="ISP — Bear Sweep",        message="Bearish liquidity sweep | {{ticker}} @ {{close}}")
alertcondition(bullBOS,        title="ISP — Bullish BOS",       message="Bullish BOS | {{ticker}} @ {{close}}")
alertcondition(bearBOS,        title="ISP — Bearish BOS",       message="Bearish BOS | {{ticker}} @ {{close}}")
alertcondition(bullCHoCH,      title="ISP — Bullish CHoCH",     message="Bullish CHoCH | {{ticker}} @ {{close}}")
alertcondition(bearCHoCH,      title="ISP — Bearish CHoCH",     message="Bearish CHoCH | {{ticker}} @ {{close}}")
alertcondition(trendDir == 1  and trendDir[1] != 1,  title="ISP — Trend → BULL", message="Trend flipped BULLISH | {{ticker}}")
alertcondition(trendDir == -1 and trendDir[1] != -1, title="ISP — Trend → BEAR", message="Trend flipped BEARISH | {{ticker}}")

// ─────────────────────────────────────────────
// ░░  END OF SCRIPT
