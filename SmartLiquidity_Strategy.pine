//@version=6
// Smart Liquidity & Structure Strategy (SLS)
// HTF Bias + Liquidity + MSS/CHOCH + Order Flow + ORB + Scoring
// Non-repainting — confirms on bar close. 2+ quality entries per session.
strategy("Smart Liquidity & Structure Strategy", shorttitle="SLS", overlay=true, pyramiding=0, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=2, commission_type=strategy.commission.percent, commission_value=0.02, calc_on_every_tick=false, process_orders_on_close=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ── INPUTS ──────────────────────────────────────────────────────────────────
useNY    = input.bool(true,  "NY AM  09:30-11:30",       group="Sessions")
useAS    = input.bool(true,  "Asia   19:00-00:00",        group="Sessions")
tzI      = input.string("America/New_York", "Timezone",   group="Sessions")
htf1     = input.timeframe("D",   "Daily",                group="HTF Bias")
htf2     = input.timeframe("240", "4H",                   group="HTF Bias")
htf3     = input.timeframe("60",  "1H",                   group="HTF Bias")
pivLen   = input.int(5,    "Pivot Lookback",  minval=2,   group="Structure")
liqLB    = input.int(30,   "Liq Lookback",   minval=5,   group="Liquidity")
slBufPct = input.float(0.05,"SL Buffer %",   step=0.01,  group="Liquidity")
rvolLen  = input.int(20,   "RVOL Length",    minval=2,   group="Order Flow")
rvolMin  = input.float(1.1, "Min RVOL",      step=0.1,   group="Order Flow")
useFVG   = input.bool(true, "Score FVG",                  group="FVG")
minScore = input.int(50,   "Min Score",                   group="Grade")
tp1R     = input.float(1.0, "TP1 R", step=0.5,           group="Risk")
tp2R     = input.float(2.0, "TP2 R", step=0.5,           group="Risk")
tp3R     = input.float(3.0, "TP3 R", step=0.5,           group="Risk")
showDash = input.bool(true, "Dashboard",                   group="Display")
showVWAP = input.bool(true, "VWAP",                        group="Display")
showORB  = input.bool(true, "ORB Lines",                   group="Display")
showLiq  = input.bool(true, "Sweep Labels",                group="Display")

// ── COLORS ──────────────────────────────────────────────────────────────────
cBull = color.new(#26a69a, 0)
cBear = color.new(#ef5350, 0)
cNeut = color.new(color.gray, 0)
cVWAP = color.new(#2962ff, 0)
cORB  = color.new(#ff9800, 0)

// ── DASHBOARD HELPER ────────────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 18, border_width=1, frame_color=color.gray, frame_width=1)

dashRow(t, i, k, v, vc) =>
    table.cell(t, 0, i, k, text_color=color.white, text_size=size.small, bgcolor=color.new(#1e1e2e, 0), text_halign=text.align_left)
    table.cell(t, 1, i, v, text_color=vc,          text_size=size.small, bgcolor=color.new(#2a2a3a, 0), text_halign=text.align_right)

// ── SESSIONS ────────────────────────────────────────────────────────────────
inNY  = not na(time(timeframe.period, "0930-1130", tzI))
inAS  = not na(time(timeframe.period, "1900-0000", tzI))
inWin = (useNY and inNY) or (useAS and inAS)
newNY = inNY and not inNY[1]
newS  = (inNY and not inNY[1]) or (inAS and not inAS[1])

var string sessName = "OFF-SESSION"
if inNY
    sessName := "NY AM"
else if inAS
    sessName := "ASIA"
else
    sessName := "OFF-SESSION"

// ── SESSION-ANCHORED VWAP ───────────────────────────────────────────────────
var float vN = na
var float vD = na
if newS
    vN := 0.0
    vD := 0.0
vN     := nz(vN) + hlc3 * volume
vD     := nz(vD) + volume
vwap   = vD > 0 ? vN / vD : close
vwBull = close > vwap
plot(showVWAP ? vwap : na, "VWAP", color=cVWAP, linewidth=2)

// ── HTF BIAS ────────────────────────────────────────────────────────────────
htfBias1(tf) =>
    c  = request.security(syminfo.tickerid, tf, close,   lookahead=barmerge.lookahead_off)
    ph = request.security(syminfo.tickerid, tf, high[1], lookahead=barmerge.lookahead_off)
    pl = request.security(syminfo.tickerid, tf, low[1],  lookahead=barmerge.lookahead_off)
    int b = 0
    if c > ph
        b := 1
    else if c < pl
        b := -1
    b

bD  = htfBias1(htf1)
b4H = htfBias1(htf2)
b1H = htfBias1(htf3)
htfSum  = bD + b4H + b1H
htfBias = htfSum > 0 ? 1 : htfSum < 0 ? -1 : 0

var string htfTxt = "NEUTRAL"
if htfBias == 1
    htfTxt := "BULLISH"
else if htfBias == -1
    htfTxt := "BEARISH"
else
    htfTxt := "NEUTRAL"

// ── MARKET STRUCTURE ────────────────────────────────────────────────────────
phV = ta.pivothigh(high, pivLen, pivLen)
plV = ta.pivotlow(low,   pivLen, pivLen)

var float lPH = na
var float pPH = na
var float lPL = na
var float pPL = na
var int   trD = 0
var string swT = "N/A"

if not na(phV)
    pPH := lPH
    lPH := phV
    swT := (not na(pPH) and phV > pPH) ? "HH" : "LH"
if not na(plV)
    pPL := lPL
    lPL := plV
    swT := (not na(pPL) and plV > pPL) ? "HL" : "LL"

bosU  = not na(lPH) and close > lPH and close[1] <= lPH
bosD  = not na(lPL) and close < lPL and close[1] >= lPL
choch = (trD <= 0 and bosU) or (trD >= 0 and bosD)
mss   = bosU or bosD

if bosU
    trD := 1
if bosD
    trD := -1

var string strTxt = "RANGING"
if trD == 1
    strTxt := "BULLISH (" + swT + ")"
else if trD == -1
    strTxt := "BEARISH (" + swT + ")"
else
    strTxt := "RANGING"

// ── LIQUIDITY MODEL ─────────────────────────────────────────────────────────
pdH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
hh  = ta.highest(high, liqLB)
ll  = ta.lowest(low,   liqLB)

var float sHi = na
var float sLo = na
if newS
    sHi := high
    sLo := low
else
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low),  low)

lRH = math.max(math.max(nz(pdH, hh), hh), nz(sHi, hh))
lRL = math.min(math.min(nz(pdL, ll), ll), nz(sLo, ll))

swH   = high > lRH and close < lRH
swL   = low  < lRL and close > lRL
swept = swH or swL

var bool recentSwH = false
var bool recentSwL = false
if swH
    recentSwH := true
    recentSwL := false
if swL
    recentSwL := true
    recentSwH := false
if ta.barssince(swH) > 6
    recentSwH := false
if ta.barssince(swL) > 6
    recentSwL := false

var float lastSwExH = na
var float lastSwExL = na
if swH
    lastSwExH := high
if swL
    lastSwExL := low

if showLiq and swH
    label.new(bar_index, high, "SSL swept", style=label.style_label_down, color=color.new(#9c27b0, 30), textcolor=color.white, size=size.tiny)
if showLiq and swL
    label.new(bar_index, low,  "BSL swept", style=label.style_label_up,   color=color.new(#9c27b0, 30), textcolor=color.white, size=size.tiny)

// ── ORDER FLOW ───────────────────────────────────────────────────────────────
rng    = high - low
bVol   = rng > 0 ? volume * (close - low)  / rng : volume * 0.5
sVol   = rng > 0 ? volume * (high - close) / rng : volume * 0.5
vDelta = bVol - sVol
rvol   = volume / math.max(ta.sma(volume, rvolLen), 1e-9)
atr14  = ta.atr(14)
body   = math.abs(close - open)

dispBull = body > atr14 * 1.5 and close > open and rvol >= rvolMin
dispBear = body > atr14 * 1.5 and close < open and rvol >= rvolMin
ofBull   = vDelta > 0 and rvol >= rvolMin
ofBear   = vDelta < 0 and rvol >= rvolMin
sofBull  = ofBull and dispBull
sofBear  = ofBear and dispBear

// ── FAIR VALUE GAP ──────────────────────────────────────────────────────────
fvgB  = useFVG and low  > high[2]
fvgBr = useFVG and high < low[2]

// ── OPENING RANGE BREAKOUT ──────────────────────────────────────────────────
// Build the 15-min opening range for NY AM only
inORBwin = not na(time(timeframe.period, "0930-0945", tzI))

var float orbH  = na
var float orbL  = na
var bool  orbOK = false

if newNY
    orbH  := high
    orbL  := low
    orbOK := false
else if inORBwin
    orbH := math.max(nz(orbH, high), high)
    orbL := math.min(nz(orbL, low),  low)
else if inNY and not inORBwin
    orbOK := true

// ORB breakout: close crosses outside the range on a confirmed bar
orbBU = orbOK and not na(orbH) and not na(orbL) and close > orbH and close[1] <= orbH
orbBD = orbOK and not na(orbH) and not na(orbL) and close < orbL  and close[1] >= orbL

var string orbTxt = "N/A"
if not orbOK and inNY
    orbTxt := "FORMING"
else if orbBU
    orbTxt := "BROKEN UP"
else if orbBD
    orbTxt := "BROKEN DOWN"
else if orbOK
    orbTxt := "SET"
else
    orbTxt := "N/A"

// draw ORB levels every bar once set (overwrite to extend them)
if showORB and orbOK and not na(orbH)
    line.new(bar_index - 1, orbH, bar_index, orbH, color=cORB, style=line.style_dashed, width=1)
    line.new(bar_index - 1, orbL, bar_index, orbL,  color=cORB, style=line.style_dashed, width=1)

// ── SCORING ENGINE ──────────────────────────────────────────────────────────
sL = 0
if htfBias == 1
    sL += 25
if swL or recentSwL
    sL += 20
if ofBull
    sL += 15
if sofBull
    sL += 5
if (mss or choch) and trD == 1
    sL += 15
if fvgB
    sL += 10
if vwBull
    sL += 10
if orbBU
    sL += 20

sS = 0
if htfBias == -1
    sS += 25
if swH or recentSwH
    sS += 20
if ofBear
    sS += 15
if sofBear
    sS += 5
if (mss or choch) and trD == -1
    sS += 15
if fvgBr
    sS += 10
if not vwBull
    sS += 10
if orbBD
    sS += 20

// ── DIRECTION + GRADE ───────────────────────────────────────────────────────
tDir  = sL >= sS ? 1 : -1
score = math.max(sL, sS)

gradeOf(x) =>
    x >= 90 ? "A+" : x >= 80 ? "A" : x >= 70 ? "B" : x >= 60 ? "C" : x >= 50 ? "C-" : "-"
grade = gradeOf(score)

// ── SIGNAL GATING ───────────────────────────────────────────────────────────
// --- Sweep / Structure path ---
scoreOK   = score >= minScore
htfNotOpp = not (htfBias == -1 and tDir == 1) and not (htfBias == 1 and tDir == -1)
trigL     = (swL or recentSwL or bosU) and ofBull
trigS     = (swH or recentSwH or bosD) and ofBear

sweepLong  = inWin and tDir == 1  and scoreOK and htfNotOpp and trigL and strategy.position_size <= 0
sweepShort = inWin and tDir == -1 and scoreOK and htfNotOpp and trigS and strategy.position_size >= 0

// --- ORB path (independent direction — the break itself defines direction) ---
// HTF must not be directly opposed; no other gate needed since ORB is a
// high-conviction institutional level. OF confirmation keeps quality high.
orbHTFokL  = htfBias >= 0
orbHTFokS  = htfBias <= 0
orbLongSig  = inNY and orbBU and ofBull and orbHTFokL and strategy.position_size <= 0
orbShortSig = inNY and orbBD and ofBear and orbHTFokS and strategy.position_size >= 0

// combined
longSig  = sweepLong  or orbLongSig
shortSig = sweepShort or orbShortSig

// ── RISK LEVELS ─────────────────────────────────────────────────────────────
var float ePx  = na
var float spPx = na
var float t1   = na
var float t2   = na
var float t3   = na

// SL for sweep/structure entries: use sweep extreme if available, else current bar
getSweepStop(d) =>
    float sv = na
    if d == 1
        float ref = not na(lastSwExL) ? math.min(lastSwExL, low) : low
        sv := ref * (1.0 - slBufPct / 100.0)
    else
        float ref = not na(lastSwExH) ? math.max(lastSwExH, high) : high
        sv := ref * (1.0 + slBufPct / 100.0)
    sv

// SL for ORB entries: anchored to the ORB range boundary
getOrbStop(d) =>
    float sv = na
    if d == 1
        sv := nz(orbL, low) * (1.0 - slBufPct / 100.0)
    else
        sv := nz(orbH, high) * (1.0 + slBufPct / 100.0)
    sv

// ── TRADE EXECUTION ─────────────────────────────────────────────────────────
var int   nyT = 0
var int   asT = 0
var float sR  = 0.0
var int   cCt = 0

// ORB long entry
if orbLongSig and not sweepLong
    ePx  := close
    spPx := getOrbStop(1)
    float rr1 = math.abs(ePx - spPx)
    t1   := ePx + rr1 * tp1R
    t2   := ePx + rr1 * tp2R
    t3   := ePx + rr1 * tp3R
    strategy.entry("ORB-L", strategy.long, comment="ORB-L " + grade)
    strategy.exit("ORB-LX", "ORB-L", stop=spPx, limit=t3, comment_loss="SL", comment_profit="TP3")
    if inNY
        nyT += 1

// ORB short entry
if orbShortSig and not sweepShort
    ePx  := close
    spPx := getOrbStop(-1)
    float rr2 = math.abs(ePx - spPx)
    t1   := ePx - rr2 * tp1R
    t2   := ePx - rr2 * tp2R
    t3   := ePx - rr2 * tp3R
    strategy.entry("ORB-S", strategy.short, comment="ORB-S " + grade)
    strategy.exit("ORB-SX", "ORB-S", stop=spPx, limit=t3, comment_loss="SL", comment_profit="TP3")
    if inNY
        nyT += 1

// Sweep/structure long entry
if sweepLong
    ePx  := close
    spPx := getSweepStop(1)
    float rr3 = math.abs(ePx - spPx)
    t1   := ePx + rr3 * tp1R
    t2   := ePx + rr3 * tp2R
    t3   := ePx + rr3 * tp3R
    strategy.entry("L", strategy.long, comment="L " + grade)
    strategy.exit("LX", "L", stop=spPx, limit=t3, comment_loss="SL", comment_profit="TP3")
    if inNY
        nyT += 1
    if inAS
        asT += 1

// Sweep/structure short entry
if sweepShort
    ePx  := close
    spPx := getSweepStop(-1)
    float rr4 = math.abs(ePx - spPx)
    t1   := ePx - rr4 * tp1R
    t2   := ePx - rr4 * tp2R
    t3   := ePx - rr4 * tp3R
    strategy.entry("S", strategy.short, comment="S " + grade)
    strategy.exit("SX", "S", stop=spPx, limit=t3, comment_loss="SL", comment_profit="TP3")
    if inNY
        nyT += 1
    if inAS
        asT += 1

if strategy.closedtrades > cCt
    float rsk = math.abs(ePx - spPx)
    if rsk > 0
        float pl = strategy.closedtrades.profit(strategy.closedtrades - 1)
        float sz = strategy.closedtrades.size(strategy.closedtrades - 1)
        sR += pl / (rsk * sz)
    cCt := strategy.closedtrades

// ── VISUALS ─────────────────────────────────────────────────────────────────
if longSig or shortSig
    isL     = longSig
    isORB   = (orbLongSig and isL) or (orbShortSig and not isL)
    lbStyle = isL ? label.style_label_up : label.style_label_down
    lbColor = isL ? cBull : cBear
    lbY     = isL ? low   : high
    pfx     = isORB ? "ORB " : ""
    lbTxt   = (isL ? "▲ " : "▼ ") + pfx + (isL ? "BUY " : "SELL ") + grade + " (" + str.tostring(score) + ")"
    label.new(bar_index, lbY, lbTxt, style=lbStyle, color=lbColor, textcolor=color.white, size=size.normal)
    // SL line — red, thick
    line.new(bar_index, spPx, bar_index + 20, spPx, color=cBear, width=2, style=line.style_dotted)
    // TP1 — faint green
    line.new(bar_index, t1, bar_index + 20, t1, color=color.new(cBull, 55), width=1, style=line.style_dotted)
    // TP2 — medium green
    line.new(bar_index, t2, bar_index + 20, t2, color=color.new(cBull, 25), width=1, style=line.style_dotted)
    // TP3 — solid green, thick
    line.new(bar_index, t3, bar_index + 20, t3, color=cBull, width=2, style=line.style_solid)

// ── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(longSig  and score >= 70, "Long A+/A/B",    "SLS LONG")
alertcondition(shortSig and score >= 70, "Short A+/A/B",   "SLS SHORT")
alertcondition(orbLongSig,               "ORB Long",        "SLS ORB LONG")
alertcondition(orbShortSig,              "ORB Short",       "SLS ORB SHORT")
alertcondition(longSig,  "Long Any",  "SLS LONG")
alertcondition(shortSig, "Short Any", "SLS SHORT")
if longSig or shortSig
    string aD = longSig ? "BUY " : "SELL "
    string aM = aD + grade + " score=" + str.tostring(score) + " @ " + str.tostring(close)
    alert(aM, alert.freq_once_per_bar_close)

// ── DASHBOARD STRINGS + COLORS ──────────────────────────────────────────────
float wR  = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100.0 : 0.0
float gP  = strategy.grossprofit
float gL2 = strategy.grossloss
float pf  = gL2 > 0 ? gP / gL2 : 0.0
float mDD = strategy.max_drawdown
float aR  = cCt > 0 ? sR / cCt : 0.0
bool aPlus = (longSig or shortSig) and score >= 90

string d01 = htfTxt
string d02 = sessName
string d03 = tDir == 1 ? "LONG" : "SHORT"
string d04 = grade + " (" + str.tostring(score) + ")"
string d05 = str.tostring(score) + "%"
string d06 = str.tostring(vDelta, "#.0")
string d07 = str.tostring(rvol, "#.00") + "x"
string d08 = orbTxt
string d09 = vwBull ? "ABOVE" : "BELOW"
string d10 = strTxt
string d11 = not swept ? "NONE" : swL ? "BSL TAKEN" : "SSL TAKEN"
string d12 = "1 : " + str.tostring(tp3R, "#.0")
string d13 = str.tostring(wR, "#.0") + "% / " + str.tostring(pf, "#.00")
string d14 = str.tostring(mDD, "#") + " / " + str.tostring(aR, "#.00") + "R"
string d15 = str.tostring(nyT) + " / " + str.tostring(asT) + " (T:" + str.tostring(strategy.closedtrades) + ")"

color c01 = htfBias == 1 ? cBull : htfBias == -1 ? cBear : cNeut
color c02 = inWin ? cBull : cNeut
color c03 = tDir == 1 ? cBull : cBear
color c04 = score >= 80 ? cBull : score >= 60 ? cORB : cNeut
color c05 = score >= 70 ? cBull : cNeut
color c06 = vDelta > 0 ? cBull : cBear
color c07 = rvol >= rvolMin ? cBull : cNeut
color c09 = vwBull ? cBull : cBear
color c10 = trD == 1 ? cBull : trD == -1 ? cBear : cNeut
color c11 = swept ? cORB : cNeut

if showDash and barstate.islast
    table.cell(dash, 0, 0, "SMART LIQUIDITY & STRUCTURE", text_color=color.white, bgcolor=color.new(#2962ff, 0), text_size=size.normal)
    table.cell(dash, 1, 0, aPlus ? "A+ ACTIVE" : "NO A+ SETUP", text_color=color.white, text_size=size.normal, bgcolor=aPlus ? cBull : color.new(#444444, 0))
    dashRow(dash,  1, "HTF Bias",        d01, c01)
    dashRow(dash,  2, "Session",          d02, c02)
    dashRow(dash,  3, "Trade Direction",  d03, c03)
    dashRow(dash,  4, "Trade Grade",      d04, c04)
    dashRow(dash,  5, "Probability",      d05, c05)
    dashRow(dash,  6, "Volume Delta",     d06, c06)
    dashRow(dash,  7, "Relative Volume",  d07, c07)
    dashRow(dash,  8, "ORB Status",       d08, cORB)
    dashRow(dash,  9, "VWAP Status",      d09, c09)
    dashRow(dash, 10, "Market Structure", d10, c10)
    dashRow(dash, 11, "Liquidity Sweep",  d11, c11)
    dashRow(dash, 12, "Risk : Reward",    d12, cBull)
    dashRow(dash, 13, "Win Rate / PF",    d13, cNeut)
    dashRow(dash, 14, "MaxDD / Avg R",    d14, cNeut)
    dashRow(dash, 15, "Trades NY / Asia", d15, cNeut)

// ── SESSION BACKGROUND ───────────────────────────────────────────────────────
bgcolor(inWin ? color.new(inNY ? #2962ff : #ff9800, 93) : na, title="Session BG")
