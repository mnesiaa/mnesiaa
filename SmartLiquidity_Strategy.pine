//@version=6
// ============================================================================
//  SMART LIQUIDITY & STRUCTURE STRATEGY (SLS)
//  Production-ready ICT-style algo: HTF Bias + Liquidity Sweeps + MSS/CHOCH
//  + Order Flow + ORB + Entry Rating Engine + Risk Mgmt + Dashboard
//
//  Works as BOTH a strategy (backtesting) and an overlay indicator.
//  Non-repainting: all signals confirm on bar close.
// ============================================================================
strategy("Smart Liquidity & Structure Strategy",
     shorttitle="SLS",
     overlay=true,
     pyramiding=0,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=2,
     commission_type=strategy.commission.percent,
     commission_value=0.02,
     calc_on_every_tick=false,
     process_orders_on_close=true,
     max_lines_count=500,
     max_labels_count=500,
     max_boxes_count=500)

// ============================================================================
//  INPUTS
// ============================================================================
grpSess   = "Session Filtering (Exchange = EST)"
useNYam   = input.bool(true,  "Trade NY AM (09:30-11:30)", group=grpSess)
useAsia   = input.bool(true,  "Trade Asia (19:00-00:00)",  group=grpSess)
tzInput   = input.string("America/New_York", "Session Timezone", group=grpSess)

grpHTF    = "Higher-Timeframe Bias Engine"
htf1      = input.timeframe("D",   "HTF #1 (Daily)", group=grpHTF)
htf2      = input.timeframe("240", "HTF #2 (4H)",    group=grpHTF)
htf3      = input.timeframe("60",  "HTF #3 (1H)",    group=grpHTF)

grpStruct = "Market Structure"
pivotLen  = input.int(5, "Pivot Lookback (bars)", minval=2, group=grpStruct)

grpLiq    = "Liquidity Model"
eqTol     = input.float(0.05, "Equal H/L Tolerance (%)", minval=0.0, step=0.01, group=grpLiq)
liqLookbk = input.int(20, "Liquidity Lookback (bars)", minval=5, group=grpLiq)

grpFlow   = "Order Flow Confirmation"
rvolLen   = input.int(20,  "Relative Volume Length", minval=2, group=grpFlow)
rvolMin   = input.float(1.3,"Min Relative Volume", minval=1.0, step=0.1, group=grpFlow)
dispMult  = input.float(1.5,"Displacement ATR Mult", minval=1.0, step=0.1, group=grpFlow)

grpFVG    = "Fair Value Gaps"
useFVG    = input.bool(true, "Require/Score FVG", group=grpFVG)

grpScore  = "Entry Rating System"
minGrade  = input.int(60, "Min Score to Trade (C=60)", minval=0, maxval=100, group=grpScore)

grpRisk   = "Risk Management"
slBufferPct = input.float(0.05, "SL Buffer beyond sweep (%)", minval=0.0, step=0.01, group=grpRisk)
tp1R      = input.float(1.0, "TP1 (R)", step=0.5, group=grpRisk)
tp2R      = input.float(2.0, "TP2 (R)", step=0.5, group=grpRisk)
tp3R      = input.float(3.0, "TP3 (R)", step=0.5, group=grpRisk)

grpUI     = "Visuals"
showDash  = input.bool(true, "Show Dashboard", group=grpUI)
showVWAP  = input.bool(true, "Show VWAP", group=grpUI)
showORB   = input.bool(true, "Show ORB levels", group=grpUI)
showLiq   = input.bool(true, "Show Liquidity zones", group=grpUI)

// ============================================================================
//  COLORS
// ============================================================================
cBull = color.new(#26a69a, 0)
cBear = color.new(#ef5350, 0)
cNeut = color.new(color.gray, 0)
cVWAP = color.new(#2962ff, 0)
cORB  = color.new(#ff9800, 0)
cLiq  = color.new(#9c27b0, 75)

// ============================================================================
//  SESSION DETECTION (timezone-aware, no repaint)
// ============================================================================
inNYam = not na(time(timeframe.period, "0930-1130", tzInput))
inAsia = not na(time(timeframe.period, "1900-0000", tzInput))
tradeWindow = (useNYam and inNYam) or (useAsia and inAsia)
sessName = inNYam ? "NY AM" : inAsia ? "ASIA" : "OFF-SESSION"

// New NY session detection (for ORB and session highs/lows)
newNYsession  = inNYam and not inNYam[1]
newAnySession = (inNYam and not inNYam[1]) or (inAsia and not inAsia[1])

// ============================================================================
//  VWAP (session-anchored)
// ============================================================================
var float vwapNum = na
var float vwapDen = na
if newAnySession
    vwapNum := 0.0
    vwapDen := 0.0
tpv = hlc3 * volume
vwapNum := nz(vwapNum) + tpv
vwapDen := nz(vwapDen) + volume
vwap = vwapDen > 0 ? vwapNum / vwapDen : close
vwapBull = close > vwap
plot(showVWAP ? vwap : na, "VWAP", color=cVWAP, linewidth=2)

// ============================================================================
//  HIGHER-TIMEFRAME BIAS ENGINE
//  Per HTF: bias from price vs prior swing structure (proxy via EMA slope of
//  HTF close + close vs prior HTF high/low) combined. Returns +1 / -1 / 0.
// ============================================================================
htfBiasCalc(tf) =>
    [c, h, l, ph, pl] = request.security(syminfo.tickerid, tf,
         [close, high, low, high[1], low[1]], lookahead=barmerge.lookahead_off)
    // Structural bias: breaking prior HTF high = bullish, prior low = bearish
    int b = 0
    if c > ph
        b := 1
    else if c < pl
        b := -1
    b

biasD  = htfBiasCalc(htf1)
bias4H = htfBiasCalc(htf2)
bias1H = htfBiasCalc(htf3)
htfScore = biasD + bias4H + bias1H
htfBias  = htfScore > 0 ? 1 : htfScore < 0 ? -1 : 0
htfBiasTxt = htfBias == 1 ? "BULLISH" : htfBias == -1 ? "BEARISH" : "NEUTRAL"

// ============================================================================
//  MARKET STRUCTURE ENGINE — HH/HL/LH/LL, MSS, CHOCH
// ============================================================================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastPH   = na
var float prevPH   = na
var float lastPL   = na
var float prevPL   = na
var int   trendDir = 0     // +1 up, -1 down
var string lastSwingType = ""

if not na(ph)
    prevPH := lastPH
    lastPH := ph
    lastSwingType := (not na(prevPH) and ph > prevPH) ? "HH" : "LH"
if not na(pl)
    prevPL := lastPL
    lastPL := pl
    lastSwingType := (not na(prevPL) and pl > prevPL) ? "HL" : "LL"

// Break of structure / MSS detection on confirmed closes
bosUp   = not na(lastPH) and close > lastPH and close[1] <= lastPH
bosDown = not na(lastPL) and close < lastPL and close[1] >= lastPL

// CHOCH = structure break opposite to prevailing trend; MSS = continuation break
choch = (trendDir <= 0 and bosUp) or (trendDir >= 0 and bosDown)
mss   = bosUp or bosDown

if bosUp
    trendDir := 1
if bosDown
    trendDir := -1

structTxt = trendDir == 1 ? "BULLISH (" + lastSwingType + ")" :
            trendDir == -1 ? "BEARISH (" + lastSwingType + ")" : "RANGING"

// ============================================================================
//  LIQUIDITY MODEL — buy/sell side liquidity + sweep detection
// ============================================================================
// Reference pools
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

var float sessHigh = na
var float sessLow  = na
if newAnySession
    sessHigh := high
    sessLow  := low
else
    sessHigh := math.max(nz(sessHigh, high), high)
    sessLow  := math.min(nz(sessLow,  low),  low)

// Equal highs/lows within lookback (clustered liquidity)
hh = ta.highest(high, liqLookbk)
ll = ta.lowest(low,  liqLookbk)
tol = eqTol / 100.0
eqHigh = math.abs(high - high[1]) <= high * tol and math.abs(high[1] - high[2]) <= high * tol
eqLow  = math.abs(low  - low[1])  <= low  * tol and math.abs(low[1]  - low[2])  <= low  * tol

// SWEEP: wick takes liquidity then closes back inside (rejection) -> non-repaint on close
sweepHigh = high > math.max(nz(prevDayHigh, hh), hh) and close < math.max(nz(prevDayHigh, hh), hh)
sweepLow  = low  < math.min(nz(prevDayLow,  ll), ll) and close > math.min(nz(prevDayLow,  ll), ll)
liqSwept  = sweepHigh or sweepLow
sweepDir  = sweepLow ? 1 : sweepHigh ? -1 : 0   // sweepLow -> bullish reversal
sweepExtremeHigh = sweepHigh ? high : na
sweepExtremeLow  = sweepLow  ? low  : na

if showLiq
    if sweepHigh
        line.new(bar_index, high, bar_index, high, color=cLiq, width=2,
             extend=extend.none, style=line.style_dotted)
        label.new(bar_index, high, "SSL swept", style=label.style_label_down,
             color=color.new(#9c27b0, 30), textcolor=color.white, size=size.tiny)
    if sweepLow
        label.new(bar_index, low, "BSL swept", style=label.style_label_up,
             color=color.new(#9c27b0, 30), textcolor=color.white, size=size.tiny)

// ============================================================================
//  ORDER FLOW CONFIRMATION — volume delta, relative volume, displacement
// ============================================================================
// Volume delta proxy (bar-internal): buying vs selling pressure
rng = high - low
buyVol  = rng > 0 ? volume * (close - low) / rng : volume * 0.5
sellVol = rng > 0 ? volume * (high - close) / rng : volume * 0.5
volDelta = buyVol - sellVol

rvol = volume / math.max(ta.sma(volume, rvolLen), 1e-9)
atr  = ta.atr(14)
bodySize = math.abs(close - open)
displacement = bodySize > atr * dispMult and rvol >= rvolMin
dispBull = displacement and close > open
dispBear = displacement and close < open

ofBull = volDelta > 0 and rvol >= rvolMin and dispBull
ofBear = volDelta < 0 and rvol >= rvolMin and dispBear

// ============================================================================
//  FAIR VALUE GAP (3-candle imbalance)
// ============================================================================
fvgBull = useFVG and low > high[2]
fvgBear = useFVG and high < low[2]

// ============================================================================
//  OPENING RANGE BREAKOUT — first 15 min of NY AM
// ============================================================================
inORBwindow = not na(time(timeframe.period, "0930-0945", tzInput))
var float orbHigh = na
var float orbLow  = na
var bool  orbSet  = false
if newNYsession
    orbHigh := high
    orbLow  := low
    orbSet  := false
else if inORBwindow
    orbHigh := math.max(nz(orbHigh, high), high)
    orbLow  := math.min(nz(orbLow,  low),  low)
else if inNYam and not inORBwindow
    orbSet := true

orbBreakUp   = orbSet and not na(orbHigh) and close > orbHigh and close[1] <= orbHigh
orbBreakDown = orbSet and not na(orbLow)  and close < orbLow  and close[1] >= orbLow
orbStatus = not orbSet and inNYam ? "FORMING" :
            orbBreakUp ? "BROKEN UP" : orbBreakDown ? "BROKEN DOWN" :
            orbSet ? "SET" : "N/A"

if showORB and orbSet
    line.new(bar_index-1, orbHigh, bar_index, orbHigh, color=cORB, style=line.style_dashed)
    line.new(bar_index-1, orbLow,  bar_index, orbLow,  color=cORB, style=line.style_dashed)

// ============================================================================
//  ENTRY RATING SYSTEM — scoring engine
// ============================================================================
// Candidate direction comes from the sweep (reversal) and structure
longBias  = sweepDir == 1  or (orbBreakUp   and htfBias >= 0)
shortBias = sweepDir == -1 or (orbBreakDown and htfBias <= 0)

scoreLong = 0
scoreLong += (htfBias == 1 ? 25 : 0)                 // HTF bias aligned
scoreLong += (sweepLow ? 20 : 0)                     // liquidity sweep
scoreLong += (ofBull ? 20 : 0)                        // order flow
scoreLong += ((mss or choch) and trendDir == 1 ? 15 : 0)  // MSS/CHOCH
scoreLong += (fvgBull ? 10 : 0)                       // FVG
scoreLong += (vwapBull ? 10 : 0)                      // VWAP alignment

scoreShort = 0
scoreShort += (htfBias == -1 ? 25 : 0)
scoreShort += (sweepHigh ? 20 : 0)
scoreShort += (ofBear ? 20 : 0)
scoreShort += ((mss or choch) and trendDir == -1 ? 15 : 0)
scoreShort += (fvgBear ? 10 : 0)
scoreShort += (not vwapBull ? 10 : 0)

// Pick the stronger directional thesis
tradeDir = scoreLong >= scoreShort ? 1 : -1
score    = math.max(scoreLong, scoreShort)

gradeOf(s) =>
    s >= 90 ? "A+" : s >= 80 ? "A" : s >= 70 ? "B" : s >= 60 ? "C" : "-"
grade = gradeOf(score)

// ============================================================================
//  SIGNAL GATING (non-repainting; confirms on close)
// ============================================================================
baseLong  = tradeWindow and tradeDir == 1  and liqSwept and (mss or choch) and ofBull
baseShort = tradeWindow and tradeDir == -1 and liqSwept and (mss or choch) and ofBear

longSig  = baseLong  and score >= minGrade and strategy.position_size <= 0
shortSig = baseShort and score >= minGrade and strategy.position_size >= 0

// ============================================================================
//  RISK MANAGEMENT
// ============================================================================
var float entryPx = na
var float stopPx  = na
var float tp1     = na
var float tp2     = na
var float tp3     = na
var int   posDir  = 0

calcLevels(dir) =>
    float e = close
    float s = dir == 1 ?
         math.min(nz(sweepExtremeLow, low), low)  * (1 - slBufferPct/100.0) :
         math.max(nz(sweepExtremeHigh, high), high) * (1 + slBufferPct/100.0)
    float r = math.abs(e - s)
    float t1 = dir == 1 ? e + r*tp1R : e - r*tp1R
    float t2 = dir == 1 ? e + r*tp2R : e - r*tp2R
    float t3 = dir == 1 ? e + r*tp3R : e - r*tp3R
    [e, s, t1, t2, t3, r]

// ============================================================================
//  BACKTEST STATS TRACKING
// ============================================================================
var int   nyTrades   = 0
var int   asiaTrades = 0
var float sumR       = 0.0
var int   closedCt   = 0

if longSig
    [e, s, t1, t2, t3, r] = calcLevels(1)
    entryPx := e, stopPx := s, tp1 := t1, tp2 := t2, tp3 := t3, posDir := 1
    strategy.entry("L", strategy.long, comment="L " + grade)
    strategy.exit("L-TP", "L", stop=s, limit=t3,
         comment_loss="SL", comment_profit="TP3")
    if inNYam
        nyTrades += 1
    if inAsia
        asiaTrades += 1

if shortSig
    [e, s, t1, t2, t3, r] = calcLevels(-1)
    entryPx := e, stopPx := s, tp1 := t1, tp2 := t2, tp3 := t3, posDir := -1
    strategy.entry("S", strategy.short, comment="S " + grade)
    strategy.exit("S-TP", "S", stop=s, limit=t3,
         comment_loss="SL", comment_profit="TP3")
    if inNYam
        nyTrades += 1
    if inAsia
        asiaTrades += 1

// Track realized R when a trade closes
if strategy.closedtrades > closedCt
    risk = math.abs(entryPx - stopPx)
    if risk > 0
        lastPnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
        sumR += lastPnl / (risk * strategy.closedtrades.size(strategy.closedtrades - 1))
    closedCt := strategy.closedtrades

// Risk:Reward (to TP3) for current candidate
curRR = tp3R

// ============================================================================
//  VISUALS — entry labels + SL/TP lines
// ============================================================================
if longSig or shortSig
    isLong = longSig
    label.new(bar_index, isLong ? low : high,
         (isLong ? "BUY " : "SELL ") + grade + "  (" + str.tostring(score) + ")",
         style=isLong ? label.style_label_up : label.style_label_down,
         color=isLong ? cBull : cBear, textcolor=color.white, size=size.normal)
    // SL / TP visualization
    line.new(bar_index, stopPx, bar_index+10, stopPx, color=cBear, width=1, style=line.style_dotted)
    line.new(bar_index, tp1,    bar_index+10, tp1,    color=cBull, width=1, style=line.style_dotted)
    line.new(bar_index, tp2,    bar_index+10, tp2,    color=cBull, width=1, style=line.style_dotted)
    line.new(bar_index, tp3,    bar_index+10, tp3,    color=cBull, width=1, style=line.style_dotted)

// ============================================================================
//  ALERTS — A+/A/B
// ============================================================================
alertcondition(longSig and score >= 70, "Long A+/A/B", "SLS LONG signal")
alertcondition(shortSig and score >= 70, "Short A+/A/B", "SLS SHORT signal")
if (longSig or shortSig) and score >= 70
    alert((longSig ? "BUY " : "SELL ") + grade + " score=" + str.tostring(score)
         + " @ " + str.tostring(close), alert.freq_once_per_bar_close)

// ============================================================================
//  DASHBOARD
// ============================================================================
// Backtest metrics
winRate = strategy.closedtrades > 0 ?
     strategy.wintrades / strategy.closedtrades * 100 : 0.0
grossProfit = strategy.grossprofit
grossLoss   = strategy.grossloss
pf = grossLoss > 0 ? grossProfit / grossLoss : na
maxDD = strategy.max_drawdown
avgR  = closedCt > 0 ? sumR / closedCt : 0.0

hasAplus = (longSig or shortSig) and score >= 90

if showDash and barstate.islast
    var table dash = table.new(position.top_right, 2, 16,
         border_width=1, frame_color=color.gray, frame_width=1)
    f_row(i, k, v, vc) =>
        table.cell(dash, 0, i, k, text_color=color.white, text_size=size.small,
             bgcolor=color.new(#1e1e2e, 0), text_halign=text.align_left)
        table.cell(dash, 1, i, v, text_color=vc, text_size=size.small,
             bgcolor=color.new(#2a2a3a, 0), text_halign=text.align_right)

    table.cell(dash, 0, 0, "SMART LIQUIDITY & STRUCTURE", text_color=color.white,
         bgcolor=color.new(#2962ff, 0), text_size=size.normal)
    table.cell(dash, 1, 0, hasAplus ? "A+ ACTIVE" : "NO A+ SETUP",
         text_color=color.white, bgcolor=hasAplus ? cBull : color.new(#444, 0),
         text_size=size.normal)

    f_row(1,  "HTF Bias",        htfBiasTxt, htfBias==1?cBull:htfBias==-1?cBear:cNeut)
    f_row(2,  "Session",         sessName, tradeWindow?cBull:cNeut)
    f_row(3,  "Trade Direction", tradeDir==1?"LONG":"SHORT", tradeDir==1?cBull:cBear)
    f_row(4,  "Trade Grade",     grade + " (" + str.tostring(score) + ")",
         score>=80?cBull:score>=60?cORB:cNeut)
    f_row(5,  "Probability",     str.tostring(score) + "%", score>=70?cBull:cNeut)
    f_row(6,  "Volume Delta",    str.tostring(volDelta, "#.0"), volDelta>0?cBull:cBear)
    f_row(7,  "Relative Volume", str.tostring(rvol, "#.00") + "x", rvol>=rvolMin?cBull:cNeut)
    f_row(8,  "ORB Status",      orbStatus, cORB)
    f_row(9,  "VWAP Status",     vwapBull?"ABOVE":"BELOW", vwapBull?cBull:cBear)
    f_row(10, "Market Structure",structTxt, trendDir==1?cBull:trendDir==-1?cBear:cNeut)
    f_row(11, "Liquidity Sweep", liqSwept?(sweepLow?"BSL TAKEN":"SSL TAKEN"):"NONE",
         liqSwept?cORB:cNeut)
    f_row(12, "Risk:Reward",     "1:" + str.tostring(curRR, "#.0"), cBull)
    f_row(13, "Win Rate / PF",   str.tostring(winRate,"#.0")+"% / "+str.tostring(pf,"#.00"),
         cNeut)
    f_row(14, "MaxDD / AvgR",    str.tostring(maxDD,"#")+" / "+str.tostring(avgR,"#.00")+"R",
         cNeut)
    f_row(15, "Trades NY/Asia",  str.tostring(nyTrades)+" / "+str.tostring(asiaTrades)
         +"  (T:"+str.tostring(strategy.closedtrades)+")", cNeut)

// ============================================================================
//  BACKGROUND TINT FOR ACTIVE SESSION
// ============================================================================
bgcolor(tradeWindow ? color.new(inNYam ? #2962ff : #ff9800, 93) : na, title="Session BG")
